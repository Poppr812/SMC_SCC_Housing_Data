  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "City of San Jose permit H23-005 (Site Development Permit/Amendment, folder year 2023), status Approved, issue date 2025-05-06: \"Site Development Permit to allow the demolition of approximately 12,500 square feet of commercial structures, and the construction of an affordable housing development consisting of 94 rental units, including one manager’s unit, and approximately 1,800 sq\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Planning Commission staff report lists the site as 1921-1927 West San Carlos Street and 30, 40 and 58 Cleveland Avenue, APNs 274-17-018, -019, -020, -021 and -022, in unincorporated Santa Clara County to be annexed to San Jose. The project demolishes five commercial structures totaling about 12,500 square feet and merges five lots into one 0.56-acre site.",
      "src": [
        "SRC-003057"
      ]
    },
    {
      "text": "Staff report gives a height of 87 feet 10 inches to top of parapet and 93 feet 6 inches to top of elevator overrun; SF YIMBY gives 83 feet and about 108,900 square feet total. CEQA clearance is a Mitigated Negative Declaration.",
      "src": [
        "SRC-003057",
        "SRC-001839"
      ]
    },
    {
      "text": "SV@Home and the city memo call the project PATH Villas at Buena Vista.",
      "src": [
        "SRC-003057",
        "SRC-003058"
      ]
    }
  ],
