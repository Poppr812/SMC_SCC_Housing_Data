  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-26-443: VTA Capitol Station, located at West Capitol Expressway and Narvaez Avenue in San Jose on a 2.68 acre site, requested and is being recommended for a reservation of $6,572,158 in annual federal tax credits, $15,925,764 in total state tax credits, and $49,738,047 of tax-exempt bond cap to finance the new construction of 203 units of housing, consisting of 201 restricted rental units and 2 unrestricted manager's units.",
      "src": [
        "SRC-001676"
      ]
    },
    {
      "text": "No closing or groundbreaking found as of November 4, 2026. In April 2026 the project was expected to break ground by November, and the $8.4 million city loan was said to fill the last gap in financing. VTA lists construction as 2026 to 2029 and held a pre-construction open house September 29, 2026.",
      "src": [
        "SRC-001928",
        "SRC-001927"
      ]
    },
    {
      "text": "City of San Jose permit MP24-001 (Ministerial Permit, folder year 2024), status Approved, issue date 2025-05-19: \"SB 35 Ministerial Permit to allow demolition of an approximately 2,450-square-foot VTA rest stop and construction of a mixed-use project consisting of VTA transit improvements and a six-story, 100% affordable multifamily development containing 203 units,\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "MidPen, December 2025: $49.3 million Affordable Housing and Sustainable Communities (AHSC) Round 9 award for 203 affordable rental homes, including 51 permanent supportive housing apartments, an all-electric building replacing a VTA parking lot, a new transit plaza, 2.28 miles of protected bikeways, upgraded walkways and new bus shelters. The CTCAC staff report lists $35,000,000 AHSC and $1,828,515 AHSC STI as project sources.",
      "src": [
        "SRC-002650",
        "SRC-001676"
      ]
    },
    {
      "text": "CEQA Notice of Exemption (SCH 2025051249), received May 28, 2025: lead agency Santa Clara County, with the Office of Supportive Housing as contact; applicant MidPen Housing Corporation; 203 units on 2.4 acres; ministerial exemption under Sec. 21080(b)(1). It lists parcels 462-15-035, 462-15-030 and 462-15-040. The city permit layer and the state progress report list the project on parcel 462-14-021.",
      "src": [
        "SRC-002648",
        "SRC-001956"
      ]
    },
    {
      "text": "City permit layer, APN 462-14-021: AD22-546 SB 35 tribal consultation (filed 2022-08-25, issued 2022-09-09, applicant MidPen Housing Corporation); MP24-001 filed 2024-03-12 by Santa Clara Valley Transportation Authority, issued 2025-05-19; AT26-007 subdivision filed 2026-03-03, tentative approval 2026-07-15; ER26-051 environmental review for MP24-001 filed 2026-04-01, under review; AD26-524 exterior remodeling (filed 2026-07-30) and AD26-599 (filed 2026-08-26) by MP Capitol Station Associates I, L.P., under review; RSL26-231 land use verification for 4015 Narvaez Av, issued 2026-10-09.",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "SF YIMBY, July 2023: 600 East Capitol Expressway next to Capitol light rail station; two six-story buildings with four- and five-story step-downs, retail and landscaped open space on a 2.7-acre site; SB 35 pre-application first filed August 2022; Mithun is project architect.",
      "src": [
        "SRC-002649"
      ]
    }
  ],
