  "construction_notes": [
    {
      "text": "Imported from the state Housing Element Annual Progress Report, which cities file themselves and which runs through 2025. Not yet checked against the city's own project list.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "CTCAC CA-22-462: Mainline North Apartments located at 2310 Calle Del Mundo in Santa Clara, requested and is being recommended for a reservation of $3,427,750 in annual federal tax credits to finance the new construction of 150 units of housing serving tenants with rents affordable to households earning 30-70% of area median income (AMI). Recorded as a note because this funding covers Mainline North Apartments (151 units), which may be one component of this record.",
      "src": [
        "SRC-001621"
      ]
    },
    {
      "text": "These parties come from the 151-unit affordable building at 2310 Calle Del Mundo, which this record merges with the Ensemble building. ZAEN is the original project developer per the report.",
      "src": [
        "SRC-001724"
      ]
    },
    {
      "text": "Split: Parkside (2301 Calle Del Mundo, 301 market-rate units) now has its own record. CTCAC lists APN 097-46-024 for Mainline North, not in county data.",
      "src": [
        "SRC-001603",
        "SRC-001914"
      ]
    }
