  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001120",
        "SRC-001121"
      ]
    },
    {
      "text": "77 affordable units, 16 reserved for residents with intellectual and developmental disabilities. The Town's list flags builder's remedy; the Los Gatan reports Grosvenor did not use it.",
      "src": [
        "SRC-001587"
      ]
    },
    {
      "text": "Town Council approved 3-2 on Jan. 13, 2026, Mary Badame and Matthew Hudes voting no. Density bonus concessions: no ground-floor commercial required in the townhomes and affordable multifamily building, and market-rate townhomes may be built before the affordable units.",
      "src": [
        "SRC-001587"
      ]
    },
    {
      "text": "CEQA notice: mixed-use building with about 7,874 sq ft of ground-floor commercial and 255 apartments; 100% affordable building with 67 lower-income apartments and one manager unit; 127 townhomes; two commercial buildings totaling 7,200 sq ft; about 3.5 acres of publicly accessible open space. Applicant listed as Grosvenor USA.",
      "src": [
        "SRC-002234"
      ]
    },
    {
      "text": "Approved conditions: the project demolishes seven single-family homes, six occupied at application.",
      "src": [
        "SRC-002235"
      ]
    }
