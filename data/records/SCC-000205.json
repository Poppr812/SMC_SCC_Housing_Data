  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001101",
        "SRC-001110"
      ]
    },
    {
      "text": "CTCAC CA-26-549: The project, 334 San Antonio Apartments, located at 334 San Antonio Road in Mountain View on a 0.62 acre site, requested and is being recommended for a reservation of $3,409,390 in annual federal tax credits, $14,000,000 in total state tax credits, and $18,750,000 of tax-exempt bond cap to finance the new construction of 100 units of housing, consisting of 99 restricted rental units and 1 unrestricted manager's unit.",
      "src": [
        "SRC-001680"
      ]
    },
    {
      "text": "Mountain View Voice reports the City Council approved the project unanimously on December 17, 2024; it replaces a Valero gas station and auto repair shop; no city funding was requested; parking requirements were waived under AB 2097 with a $50 monthly transit subsidy for three years.",
      "src": [
        "SRC-003158",
        "SRC-003157"
      ]
    },
    {
      "text": "An earlier market-rate project by a different applicant, a five-story for-sale condominium building with ground-floor commercial, was approved in October 2022; that approval expired before CRP bought the property. The state report lists it as 62 units under file PL-2021-130.",
      "src": [
        "SRC-003159",
        "SRC-003157",
        "SRC-001110"
      ]
    },
    {
      "text": "Mountain View Voice (June 2024) names Seth Sterneck, managing director, and Jack Burlison, director, of CRP Affordable Housing, and gives affordability as 30% to 70% of AMI; the November 2024 article says at or below 80% of AMI.",
      "src": [
        "SRC-003159",
        "SRC-003157"
      ]
    },
    {
      "text": "CEQAnet Notice of Exemption (statutory, CEQA Guidelines 15194): Planned Community Permit and Development Review Permit to demolish a service station and build an eight-story project of 99 affordable rental units and one manager unit using State Density Bonus Law on a 0.62-acre site.",
      "src": [
        "SRC-003160"
      ]
    },
    {
      "text": "County parcel data gives the situs for APN 148-15-020 as 364 San Antonio Rd.",
      "src": [
        "SRC-001098"
      ]
    }
  ],
