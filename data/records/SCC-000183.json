  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-21-750: The Kelsey Ayer Station, located at 447 North 1st Street in San Jose, requested and is being recommended for a reservation of $2,584,466 in annual federal tax credits to finance the new construction of 113 units of housing serving tenants with rents affordable to households earning 20-80% of area median income (AMI).",
      "src": [
        "SRC-001616"
      ]
    },
    {
      "text": "City of San Jose permit H19-019 (Site Permit, folder year 2019), status Review Letter Sent: \"Site Development Permit to allow the demolition of the existing building and construction of a new six-story, 115-unit multi-family (with approximately 77% of affordable units) on an approximately 0.47-gross acre site\"",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "City of San Jose permit H20-005 (Site Development Permit/Amendment, folder year 2020), status Approved, issue date 2020-02-28: \"SB 35 Streamlined Ministerial Permit to allow the demolition of an existing commercial building and the construction of a 115-unit multi-family apartment building with 87 affordable housing units on an approximately 0.47-gross acre site.\"",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC staff report lists general partners The Kelsey Ayer Station LLC, North First Street - San Jose MF, LLC and DGI Kelsey LLC (joint venture; parents The Kelsey, Sares Regis Group of NC, Devine & Gong, Inc.). Staff noted a per-unit development cost of $590,715.",
      "src": [
        "SRC-001616"
      ]
    },
    {
      "text": "Devcon Construction lists the project as design-build, completed 2024: a six-story building with five floors of units over a podium, replacing a two-story office building.",
      "src": [
        "SRC-002962"
      ]
    },
    {
      "text": "County parcel data shows the record's APN 264-30-087 with situs 447 S 1st St; the project address is 447 N 1st St.",
      "src": [
        "SRC-001098"
      ]
    }
