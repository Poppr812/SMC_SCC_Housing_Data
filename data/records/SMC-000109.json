  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001125",
        "SRC-001122"
      ]
    },
    {
      "text": "City lists APNs 021-324-190, 021-324-310 and 021-324-320. Replaces eight occupied residential units and the Best Western El Rancho Inn.",
      "src": [
        "SRC-001357"
      ]
    },
    {
      "text": "Hanover lists the property as Hanover Millbrae, 384 units, midrise, under construction; its page gives the address as 1100 El Camino Real, San Bruno, CA 94066.",
      "src": [
        "SRC-002263"
      ]
    },
    {
      "text": "SCEA: five-story apartment building wrapping a six-level above-ground garage (about 203,514 gsf); a future seven-story hotel of up to 200 rooms on the remaining 1.2 acres under a separate application; 6.7 acres total.",
      "src": [
        "SRC-002264"
      ]
    },
    {
      "text": "City page: Planning Commission voted 5-0 to adopt the SCEA and 3-2 to approve the Design Review Permit on March 7, 2022; height limit waiver to about 63 feet 5 inches; 69 units per acre; 72 bicycle spaces.",
      "src": [
        "SRC-001357"
      ]
    },
    {
      "text": "City page lists owners at application: APN 021-324-190 El Rancho Motel, Inc.; APN 021-324-320 EMJP Partners LP; APN 021-324-310 held by trustees. County parcel layer shows APNs 021-324-190 and 021-324-320 with Anton Millbrae LLC as lessee and Millbrae MF Owner LLC, and APN 021-324-310 with Anton Millbrae LLC as lessee and a trust, care of Anton DevCo Inc.",
      "src": [
        "SRC-001357",
        "SRC-001103"
      ]
    }
  ],
