  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-24-672: The project, 525 N Capitol, located at 525 North Capitol Avenue in San Jose on a 0.97 acre site, requested and is being recommended for a reservation of $4,592,462 in annual federal tax credits and $62,535,038 of tax-exempt bond cap to finance the new construction of 160 units of housing, consisting of 158 restricted rental units and 2 unrestricted manager's units.",
      "src": [
        "SRC-001653"
      ]
    },
    {
      "text": "City of San Jose permit MP22-011 (Ministerial Permit, folder year 2022), status Approved, issue date 2023-09-01: \"SB 35 Ministerial Permit to allow the demolition of an existing concrete pad and new construction of a 5-story mixed-use affordable housing project consisting of 160 affordable housing rental units, including two manager's units, and 2,900 square feet of\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Developer page: 15 permanent supportive housing units, 25 HUD-VASH units for homeless veterans, 12 units for people with intellectual or developmental disabilities; LEED Gold target; car and bike parking on the ground floor. Funders listed: San Jose Measure E, Santa Clara County Measure A and I/DD funds, HCD Infill Infrastructure Grant, California Department of Developmental Services.",
      "src": [
        "SRC-001976"
      ]
    },
    {
      "text": "California Construction News (May 2026) names First Citizens Bank as construction lender, Citi as permanent lender and CREA, LLC as equity investor. The CTCAC staff report (Dec 2024) shows Citibank as construction and permanent lender.",
      "src": [
        "SRC-002730"
      ]
    }
