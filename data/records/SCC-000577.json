  "construction_notes": [
    {
      "text": "CTCAC CA-21-629: The Meridian, located at 3941 Stevens Creek Boulevard in Santa Clara, requested and is being recommended for a reservation of $2,694,252 in annual federal tax credits and $15,543,761 in total state tax credits to finance the new construction of 58 units of housing serving large families with rents affordable to households earning 30-80% of area median income (AMI).",
      "src": [
        "SRC-001605"
      ]
    },
    {
      "text": "Housing Choices listing: 10 one-bedroom units are set aside under HUD Section 811 Project Rental Assistance for households at or below 30% of AMI, with tenants paying 30% of income; site at the corner of Stevens Creek Blvd and Buckingham Drive.",
      "src": [
        "SRC-003400"
      ]
    },
    {
      "text": "Dahlin project page: 87,991 sq ft building area on 0.58 acres, 101.7 units per acre; ground-floor community-serving retail, supportive services and bicycle storage; second-level courtyard with adjacent community room.",
      "src": [
        "SRC-003401"
      ]
    },
    {
      "text": "The state report lists the building permit and certificate of occupancy (BLD21-63323) at 3945 Stevens Creek Blvd on APN 294-39-010; the planning application and the CTCAC staff report use 3941 Stevens Creek Blvd.",
      "src": [
        "SRC-001102",
        "SRC-001106",
        "SRC-001605"
      ]
    },
    {
      "text": "Silicon Valley at Home's April 25, 2024 post names Related California as developer of The Meridian at 3941 Stevens Creek Boulevard; the CTCAC staff report and the Dahlin project page name CRP Affordable Housing and Community Development as developer.",
      "src": [
        "SRC-003403",
        "SRC-001605",
        "SRC-003401"
      ]
    },
    {
      "text": "CTCAC staff report: general partners Central Valley Coalition For Affordable Housing and CRP Meridian AGP LLC (joint venture); bond issuer California Municipal Finance Authority; investor/consultant Hunt Capital Partners.",
      "src": [
        "SRC-001605"
      ]
    }
