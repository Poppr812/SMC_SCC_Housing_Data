  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "Ensemble's 2025 release gives the address as 2240 Calle de Luna, the county situs address of APN 097-46-019. SF YIMBY (2023) gives 2278 Calle Del Luna for the same 311-unit, eight-story mid-rise.",
      "src": [
        "SRC-002162",
        "SRC-002164",
        "SRC-001098"
      ]
    },
    {
      "text": "The 2019 approval covered two Tasman East parcels: Parcel 19 (311 units, 1.87 acres) and Parcel 29 (192 units). SF YIMBY describes the 192-unit Parcel 29 building as a 20-story high-rise with 8,000 sq ft of retail and a 218-car garage, the second phase. The Parcel 29 in-lieu park fee of $3,825,837 is due by April 2030 or at its first building permit.",
      "src": [
        "SRC-001722",
        "SRC-002164"
      ]
    },
    {
      "text": "Developer pages describe 311 units: 111 furnished flexible-term apartments and 200 unfurnished. Ensemble's 2025 release lists starting rents of $2,811 (studio), $3,110 (one-bedroom), $4,881 (two-bedroom) and $6,590 (three-bedroom).",
      "src": [
        "SRC-002166",
        "SRC-002162"
      ]
    }
  ],
