  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001112",
        "SRC-001113"
      ]
    },
    {
      "text": "Retail: 3,388 SF at 500 Linden and 560 SF at 522 Linden.",
      "src": [
        "SRC-001342"
      ]
    },
    {
      "text": "CTCAC CA-26-410: Rotary Gardens, located at 500 Linden Avenue in South San Francisco on a 0.49 acre site, requested $3,651,611 in annual federal tax credits but is being recommended for $3,385,453 in annual federal tax credits and $20,562,128 of tax-exempt bond cap to finance the new construction of 80 units of housing, consisting of 79 restricted rental units and 1 unrestricted manager's unit. Recorded as a note because this funding covers Rotary Gardens (80 units), which may be one component of this record.",
      "src": [
        "SRC-001674"
      ]
    },
    {
      "text": "San Mateo County AHF predevelopment pipeline, September 2024: Rotary Gardens (Beacon Dev.): 79 total units, 25% at 15-30% AMI and 75% at 31-60% AMI.",
      "src": [
        "SRC-001649"
      ]
    },
    {
      "text": "City resolution RES 187-2023 describes Rotary Gardens at 500 and 522 Linden as a two-phase project by the local Rotary Club and Beacon Development: an 83-unit senior building in phase 1 and an anticipated 65-unit family building in phase 2. The applicants had requested about $7.5 million from the city.",
      "src": [
        "SRC-002809"
      ]
    },
    {
      "text": "CTCAC CA-26-410 shows total project cost of $77,834,793 for the 80-unit senior building ($966,935 per unit), with $9,061,657 developer fee and $47,580,000 construction costs. The county HOME notice (March 2026) estimates total project cost at $79,877,218.",
      "src": [
        "SRC-001674",
        "SRC-002810"
      ]
    },
    {
      "text": "County HOME notice describes the 500 Linden site as a vacant two-story commercial building built in 1971, last occupied by Liberty Bank, and the development as two new 6-story buildings (five stories of Type III over a one-story plus basement Type I podium) providing 80 affordable senior units including one manager's unit.",
      "src": [
        "SRC-002810"
      ]
    }
  ],
