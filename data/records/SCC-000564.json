  "construction_notes": [
    {
      "text": "The city lists two applications for this parcel. Application 2 is the 44-unit apartment project; Application 1 (CPX24-0013) is six single-family homes with two affordable ADUs, 8 units.",
      "src": [
        "SRC-001568"
      ]
    },
    {
      "text": "Four three-story buildings of 11 units each, about 38 feet tall, on a 40,000 sq ft parcel (net 38,670 sq ft) zoned R-1-40,000. One existing occupied single-family home would be demolished. Removal of 18 of 27 protected trees requested.",
      "src": [
        "SRC-003539",
        "SRC-003538",
        "SRC-001567"
      ]
    },
    {
      "text": "Preliminary application cites Government Code 65589.5(d)(5). The city's 2025-06-27 letter says it intends to impose conditions under 65589.5(f)(1) for height, floor area, setbacks and site coverage, and lists multifamily use and density as inconsistent with R-1-40,000 standards it does not intend to impose.",
      "src": [
        "SRC-003538",
        "SRC-003539"
      ]
    }
