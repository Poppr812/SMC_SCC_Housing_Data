  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "City of San Jose permit H20-013 (Site Development Permit/Amendment, folder year 2020), status Approved, issue date 2021-02-28: \"AB 2162 Ministerial Permit to allow the demolition of an existing 11,811 square foot commercial building and the construction of a 5-story, 100% affordable residential development of 79 units, with 39 units reserved for permanent supportive housing, with\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC 2021 staff report lists the project as Bascom Apartments at 3090 South Bascom Avenue (CA-21-593): $3,062,012 annual federal and $17,533,058 total state credits recommended, 79 units with 77 restricted, 16 units (21%) with HUD Section 8 project-based vouchers.",
      "src": [
        "SRC-003236"
      ]
    },
    {
      "text": "CTCAC 2021 financing at application: construction from Boston Capital Finance $35,672,716, Santa Clara County $14,220,000, tax credit equity $17,346,275; permanent from Boston Capital $9,270,288, Santa Clara County $15,800,000, deferred developer fee $1,000,000, tax credit equity $41,168,703; total $67,238,991. Investor/consultant Red Stone Equity Partners.",
      "src": [
        "SRC-003236"
      ]
    },
    {
      "text": "April 2024 developer release names different partners than the 2021 CTCAC report: U.S. Bank $36 million construction and permanent loan, Boston Financial Investment Management $40 million tax credit equity, Housing Trust Silicon Valley $7.7 million acquisition loan, County Measure A $15.8 million; project-based vouchers from the Santa Clara County Housing Authority and the VA.",
      "src": [
        "SRC-003232"
      ]
    },
    {
      "text": "VMWP lists the building at 28,000 sq ft on a 0.64-acre site; awards: PCBC Gold Nugget Grand Award, Best Health/Wellness Design Solution 2024, and Merit, Best Affordable Housing 2024. Rated GreenPoint Platinum.",
      "src": [
        "SRC-003234",
        "SRC-003235"
      ]
    }
