  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-23-608: Martha Gardens Apartments, located at 802 South 1st Street in San Jose, requested and is being recommended for a reservation of $4,783,814 in annual federal tax credits to finance the new construction of 164 units of housing serving tenants with rents affordable to households earning 30%-70% of area median income (AMI).",
      "src": [
        "SRC-001641"
      ]
    },
    {
      "text": "City of San Jose permit PD21-011 (Planned Development Permit/Amendment, folder year 2021), status Approved, issue date 2022-10-12: \"RE: File No. PD21-011 and PT21-031: Planned Development Permit and a Tentative Map to allow the demolition of 31,152-square feet of commercial buildings and construction of a mixed-use multifamily housing project consisting of a six-story building with a\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC staff report CA-23-608: bond issuer California Municipal Finance Authority; general partners Central Valley Coalition for Affordable Housing, TPC Holdings IX, LLC and San Jose - Martha Gardens, LLC; census tract 5016.01; approved developer fee $9,800,000.",
      "src": [
        "SRC-001641"
      ]
    },
    {
      "text": "SF YIMBY (October 3, 2021): 2021 application proposed 246 studios, 37 affordable (22 at 80% AMI, 15 at 50% AMI), six stories, 71 feet, 4,660 sq ft retail, 76 parking spaces; sponsor Maracor Development; architect AO.",
      "src": [
        "SRC-002728"
      ]
    },
    {
      "text": "San Jose Inside (August 12, 2025): six-story modular building on the former Wheel Works tire store site, within the Martha Gardens Specific Plan, 75-plus parking spaces; joint effort of Maracor Development and The Pacific Cos.",
      "src": [
        "SRC-002729"
      ]
    }
