  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001120",
        "SRC-001121"
      ]
    },
    {
      "text": "Planning Commission staff report (meeting 2019-03-27): merge APNs 527-44-012 and 013 and build a 2,511 sq ft office building with three attached condominiums on the north part of the site and six detached single-family condominiums on a private driveway on the south part; zoned C-1, General Plan Neighborhood Commercial. The site had been vacant since a commercial building (last a restaurant) was demolished in 2001. An earlier eight-unit proposal was approved by the Planning Commission on 2015-02-25, remanded on appeal by the Town Council on 2015-06-16, and expired.",
      "src": [
        "SRC-004184"
      ]
    },
    {
      "text": "Council agenda report for 2019-11-19: the developer, Cashmere Bouquet 1031, L.L.C., filed the Final Map for Tract No. 10514 creating one parcel for the mixed-use building and six parcels for the detached condominiums, with public service and emergency vehicle access easements.",
      "src": [
        "SRC-004186"
      ]
    },
    {
      "text": "Restricted units differ by source: the staff report shows one Below Market Price unit at 80% of median; the state report shows two deed-restricted units (one at 80%, one at 120%).",
      "src": [
        "SRC-004184",
        "SRC-001121"
      ]
    }
