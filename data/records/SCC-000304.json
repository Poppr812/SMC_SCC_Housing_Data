  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "City of San Jose permit H20-035 (Site Development Permit/Amendment, folder year 2020), status Approved, issue date 2023-09-27: \"Site Development Permit to allow the demolition of 30 residential units and the removal of 47 trees (19 ordinance-size, 28 non-ordinance-size) for the construction of 41 residential condominium units configured in five three-story buildings on an approxim\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "City of San Jose permit PRE20-102 (Prelim - Focused (Policy Review, No Plans), folder year 2020), status Complete: \"Folder for SB 330 Preliminary Application Review\"",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Project covers 2323, 2369, 2389 and 2391 Moorpark Avenue (seven parcels, 2.01 gross acres) on the north side of Moorpark Avenue west of Central Way, in unincorporated Santa Clara County. Existing 14 buildings with 30 vacant multifamily rental units would be demolished. Townhomes are 2- and 3-bedroom, about 1,100 to 1,800 sq ft, with attached two-car garages; access by a private looped drive from the Central Way cul-de-sac.",
      "src": [
        "SRC-003572",
        "SRC-003574",
        "SRC-003573"
      ]
    },
    {
      "text": "City staff report (July 2023): the city does not intend to complete the annexation until a building permit is issued; LAFCO certification would follow building permit issuance. County parcel dataset lists APN 282-01-022 jurisdiction as Unincorporated.",
      "src": [
        "SRC-003573",
        "SRC-001098"
      ]
    }
