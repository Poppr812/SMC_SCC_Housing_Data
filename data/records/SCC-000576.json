  "construction_notes": [
    {
      "text": "CTCAC CA-21-512: Hecker Pass Apartments, located at 1520 Hecker Pass Highway in Gilroy, requested and is being recommended for a reservation of $1,470,942 in annual federal tax credits to finance the new construction of 99 units of housing serving large families with rents affordable to households earning 30-60% of area median income (AMI).",
      "src": [
        "SRC-001602"
      ]
    },
    {
      "text": "Gilroy Dispatch: five three-story buildings with two- and three-bedroom units, a 2,700 sq ft clubhouse and 200 parking spaces on nearly four acres at the southwest corner of Hecker Pass Highway and Santa Teresa Boulevard. Approved administratively March 12, 2021 with a CEQA infill exemption; home demolished and grading under way in late 2021.",
      "src": [
        "SRC-003022"
      ]
    },
    {
      "text": "CTCAC staff report: 5 residential buildings; bond issuer California Municipal Finance Authority with expected issuance September 1, 2021; investor Boston Financial; construction sources Align Finance tax-exempt $25,000,000, Align Finance $9,000,000, lease-up income $358,333, deferred reserve funding $1,127,064, deferred developer fee $4,147,074 and tax credit equity $9,222,467.",
      "src": [
        "SRC-001602"
      ]
    },
    {
      "text": "State report lists financial assistance as Sec 811, LIHTC and CDLAC.",
      "src": [
        "SRC-001138"
      ]
    }
  ],
