  "construction_notes": [
    {
      "text": "CTCAC CA-23-517: Stevens Creek Promenade, located at 4300 Stevens Creek Boulevard in San Jose, requested and is being recommended for a reservation of $5,867,538 in annual federal tax credits and $19,600,000 in total state tax credits to finance the new construction of 171 units of housing serving families with rents affordable to households earning 30%-70% of area median income (AMI). Recorded as a note because this funding covers Stevens Creek Promenade (173 units), which may be one component of this record.",
      "src": [
        "SRC-001638"
      ]
    },
    {
      "text": "CTCAC CA-23-517 (Aug. 2023), affordable building: one residential building, 173 units (44 studio, 37 one-bedroom, 45 two-bedroom, 47 three-bedroom); total development cost $119,084,744; general partners Central Valley Coalition for Affordable Housing, TPC Holdings IX, LLC and Miramar Property Group, LLC; developer Pacific West Communities, Inc.; bond issuer CalHFA; investor Boston Financial; management agent ConAm Management Corporation.",
      "src": [
        "SRC-001638"
      ]
    },
    {
      "text": "CalHFA final commitment report (SLC 2024-01-05): seller MGP Stevens Creek Owner, LLC, an affiliate of master developer Miramar Capital, agreed to sell the site to San Jose Stevens Creek Associates for $3,470,000 under a purchase agreement dated 2023-02-07; a March 2023 land appraisal valued the site at $13,840,000 and an October 2023 appraisal at $4,000,000. Total bond issuance $108,550,152. The site is portions of two parcels to be split before construction.",
      "src": [
        "SRC-002678"
      ]
    }
  ],
