  "construction_notes": [
    {
      "text": "Two six-story buildings; Phase 1: 207 units, five stories over one podium level, no retail; Phase 2: 223 units with ground-floor commercial space",
      "src": [
        "SRC-000124"
      ]
    },
    {
      "text": "Building A 220 units and Building B 210 units; podium-style; about 80 feet tall; construction estimated at 33 months in two phases",
      "src": [
        "SRC-000126"
      ]
    },
    {
      "text": "Demolition of 13 office buildings (about 49,088 sq ft); new buildings total about 923,224 sq ft; emergency vehicle access roads and a basketball court in Bell Street Park",
      "src": [
        "SRC-000125"
      ]
    },
    {
      "text": "CTCAC application CA-26-694, 2160 Euclid Ave Apartments: 210 total units, 208 low-income, 2160 Euclid Ave, APN 063-292-380 (a portion of). Application, not an award: bond request $43,000,000, federal credit request $8,113,303 (CDLAC September 8, 2026 applicant list).",
      "src": [
        "SRC-001684"
      ]
    },
    {
      "text": "CTCAC application CA-26-694 (2160 Euclid Ave Apartments, one of the two buildings): 210 units (208 low-income plus 2 manager units); total project cost $160,861,026; one six-story elevator building of modular residential over three levels of partial podium parking; 2.25 net acres; 325 parking spaces; 99-year ground lease from Ravenswood City School District; Qualified Census Tract. Application, not an award.",
      "src": [
        "SRC-001684"
      ]
    },
    {
      "text": "CA-26-694 unit mix for the 210-unit phase: 12 studios, 133 one-bedroom, 41 two-bedroom (including 2 manager units), 24 three-bedroom. Income targeting of the 208 restricted units: 21 at 30% AMI, 21 at 50% AMI, 83 at 60% AMI, 83 at 70% AMI.",
      "src": [
        "SRC-001684"
      ]
