  "construction_notes": [
    {
      "text": "New mobile home park with 575 rental units. County status: Incomplete, August 6, 2026.",
      "src": [
        "SRC-001431"
      ]
    },
    {
      "text": "Plan set (PLN25-107-SB330, revisions dated 2025-06-20 through 2026-10-28) describes an equestrian-oriented community in the Mt. Pleasant foothills: a subdivision for 443 single-family homes and 110 ADUs (553 units), riding arenas, event center, stables, office and community center, with horse trails connecting to Joseph D. Grant County Park. It lists APNs 654-16-006, 654-15-029 and 654-15-030, Higuera Road, San Jose 95148.",
      "src": [
        "SRC-002225"
      ]
    },
    {
      "text": "County list: development area 836,550 sq ft; Supervisor District 1. The county's Project B description (575-unit mobile home park, 115 low-income units) differs from the plan set's 443 homes and 110 ADUs.",
      "src": [
        "SRC-001431",
        "SRC-002225"
      ]
    },
    {
      "text": "SF YIMBY (July 2025): riding arenas over 40,000 sq ft, event center over 18,000 sq ft, stables over 12,500 sq ft, offices about 2,800 sq ft, community center/restaurant/retail nearly 13,000 sq ft.",
      "src": [
        "SRC-002226"
      ]
    }
