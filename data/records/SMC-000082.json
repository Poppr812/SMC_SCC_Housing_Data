  "construction_notes": [
    {
      "text": "Revised project removes 415 S. Claremont St and 521 E. 5th Ave",
      "src": [
        "SRC-001038"
      ]
    },
    {
      "text": "IS/MND (Oct. 2026, SCH 2023090277): seven stories, about 167,489 sq ft, max height 85 ft, FAR 4.95, two below-grade parking levels; offices on floors 1-3 and 7, residential on floors 4-6; 12 BMR units. Site APNs 034-186-070, -080 and -110 (0.77 acres), now a Taco Bell, surface parking, a single-family home and a vacant gas station site. The IS/MND states the project lacks two-thirds residential floor area to qualify as a housing development project under Gov. Code 65589.5.",
      "src": [
        "SRC-003265"
      ]
    },
    {
      "text": "IS/MND applicant block lists APN 034-186-034 for 411 Claremont Street; its project description and county parcel data use 034-186-070.",
      "src": [
        "SRC-003265",
        "SRC-003267"
      ]
    },
    {
      "text": "Original Dec. 2022 version: six stories, 86 ft, 86 apartments (41 studio, 35 1BR, 10 2BR, 9 very low-income), 142,050 sq ft office, 269 parking spaces. ARC TEC, KLA and BKF credited on that version.",
      "src": [
        "SRC-003266"
      ]
    }
