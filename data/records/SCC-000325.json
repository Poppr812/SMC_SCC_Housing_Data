  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001118",
        "SRC-001119"
      ]
    },
    {
      "text": "City of Sunnyvale Legistar: Planning Commission approved the Special Development Permit (File 2021-7110) on 2023-10-23 to demolish a two-story office building and build a 29-unit, seven-story apartment building. Applicant Pacific General Construction; owner Neoelixir, Inc.",
      "src": [
        "SRC-003721"
      ]
    },
    {
      "text": "Project data table: gross floor area 76,797 sq ft (FAR 335%), building height 83 ft, 55 units per acre, unit sizes 1,360 to 1,548 sq ft, 8 Class I and 3 Class II bike spaces. Development standards in effect on 2021-10-10 applied because of an SB 330 preliminary application. SF YIMBY gives the height as 82 ft.",
      "src": [
        "SRC-003720",
        "SRC-003724"
      ]
    },
    {
      "text": "Applicant letter: rental project designed for roommates with a bathroom per bedroom; 4 BMR units (3 low income, 1 very low income), one of each of four unit types; density bonus waivers for podium setbacks and open space; mechanized CityLift Puzzle parking; estimated 80-week single-phase construction.",
      "src": [
        "SRC-003723"
      ]
    },
    {
      "text": "San Jose Spotlight: 111 beds on a half-acre site replacing a two-story office; Planning Commission vote was unanimous with two commissioners absent.",
      "src": [
        "SRC-003725"
      ]
    },
    {
      "text": "State Annual Progress Report 2023: 12 density bonus units; 12 non-restricted units counted as moderate income based on the city's rent analysis.",
      "src": [
        "SRC-001119"
      ]
    }
