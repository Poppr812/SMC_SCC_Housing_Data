  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001118"
      ]
    },
    {
      "text": "Sunnyvale Planning Commission file 19-1020 lists files 2017-7848, 2017-7879, 2019-7250, 2019-7251 and 2019-7252 together, including 325 attached residential units and ground-floor retail on a 4.7-acre site on Town Center Sub-block 6 (APNs written as 209-25-016, 017, 018 and 019); applicants City of Sunnyvale, STC Ventures, Minkoff Group, Giurland, Inc.",
      "src": [
        "SRC-002286"
      ]
    },
    {
      "text": "REBusinessOnline (Aug. 2020): Council approved the Downtown Specific Plan and Development Agreement for the next CityLine phase, 792 residential units on four parcels along Murphy and McKinley avenues, including Block 3S (480 apartments) and Block 6 (312 apartments, 11% affordable, 35,000 sq ft retail); construction was scheduled to begin in early 2021.",
      "src": [
        "SRC-002287"
      ]
    },
    {
      "text": "Bisnow (Sept. 2019): CityLine Phase 2 called for 792 residential units, in entitlements; STC Venture bought the 36-acre project in 2016 for $100M.",
      "src": [
        "SRC-002292"
      ]
    },
    {
      "text": "County parcel data: APN 204-44-026 has situs 222 N Murphy Ave; APN 209-35-016 has situs 240 S Murphy Ave; APN 209-35-018 has situs 230 S Murphy Ave. The state report lists APN 209-35-016 for file 20197250.",
      "src": [
        "SRC-001098",
        "SRC-001118"
      ]
    }
