  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-25-492: Lupina, located at 797 South Almaden Avenue in San Jose on a 0.63 acre site, requested and is being recommended for a reservation of $4,698,742 in annual federal tax credits and $53,314,000 of tax-exempt bond cap to finance the new construction of 99 units of housing, consisting of 98 restricted rental units and 1 unrestricted manager's unit.",
      "src": [
        "SRC-001662"
      ]
    },
    {
      "text": "The project is now called Lupina.",
      "src": [
        "SRC-001934",
        "SRC-001935",
        "SRC-001936"
      ]
    },
    {
      "text": "SF YIMBY reports $53.3 million from JPMorgan Chase and a $28.9 million loan from Santa Clara County, with full construction nearly $100 million. The JPMorgan figure matches the Chase tax-exempt construction loan in the CTCAC plan on this record ($53,314,000). The county figure is higher than the Measure A and NPLH rows together ($25,350,000).",
      "src": [
        "SRC-001937"
      ]
    },
    {
      "text": "City of San Jose permit H21-013 (Ministerial Permit, folder year 2021), status Approved, issue date 2022-01-28: \"AB 2162 Streamlined Ministerial Permit for the demolition of two single-family homes, accessory structures, and a 2,689 sq. ft. commercial building; and the construction of a 6-story 100% affordable apartment project, consisting of 99 apartments and 2315\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "City GIS lists the owner/applicant entity as Almaden Affordable Housing, L.P. (c/o RCD) and files the newer records under APN 984-88-001; earlier files sit on APN 264-34-042 (771 Almaden Ave). Neither APN appears in the current county parcel dataset. Earlier preliminary review PRE20-139 (RCD) described 94 affordable apartments with ground-floor commercial.",
      "src": [
        "SRC-001956",
        "SRC-001098"
      ]
    },
    {
      "text": "Gross building area 102,119 sq ft per the architect and city file AD25-058. Architect lists all-electric design, targeted GreenPoint Rated Platinum, and an elevated ground floor for flood mitigation.",
      "src": [
        "SRC-003028",
        "SRC-001956"
      ]
    },
    {
      "text": "RCD page: ground floor holds an approximately 2,300 sq ft affordable childcare center operated by Kids First Academy and 3,300 sq ft of open space on S. Almaden Ave; units for households under 60% AMI.",
      "src": [
        "SRC-003027"
      ]
    },
    {
      "text": "Parking counts differ: SF YIMBY reports 92 spaces; RCD's page lists 68 vehicle spaces.",
      "src": [
        "SRC-001408",
        "SRC-003027"
      ]
    }
  ],
