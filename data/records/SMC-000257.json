  "construction_notes": [
    {
      "text": "City gives no street number; address is from the architect's page.",
      "src": [
        "SRC-001235"
      ]
    },
    {
      "text": "City page: existing site has thirty-five 2-story buildings with 232 units, a leasing/amenity building and 482 parking spaces; 64 units and 180 spaces would be demolished.",
      "src": [
        "SRC-001234"
      ]
    },
    {
      "text": "BDE Architecture: 10 existing buildings replaced by one apartment building of 392 units and a separate clubhouse with 28 units; car stackers in the first-floor garage; building steps from 5 to 3 stories; LEED Gold proposed; client listed as Equity Real Estate.",
      "src": [
        "SRC-001235"
      ]
    },
    {
      "text": "HCD 2020 letter: 588 total units at about 35 units per acre; General Plan Apartment Residential (20-35 du/acre); zoning R-3/PD, where standards allow at most 19.89 du/acre; HCD said the city cannot require a rezoning under the Housing Accountability Act.",
      "src": [
        "SRC-002251"
      ]
    }
