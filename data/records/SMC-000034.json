  "construction_notes": [
    {
      "text": "CTCAC CA-22-080 Baden Station: 36 total units, 35 low-income units; stage Preliminary Reservation; developer Baden Station Investors, LLC; annual federal credit 1690560; total state credit None.",
      "src": [
        "SRC-001603"
      ]
    },
    {
      "text": "The 2020 entitlement was a market-rate project with three very-low-income density bonus units. In October 2021 the City approved assignment of the purchase agreement to For the Future Housing and a change to a fully affordable 36-unit project, with 35 units restricted for 55 years plus a manager unit.",
      "src": [
        "SRC-003624"
      ]
    },
    {
      "text": "432 Baden Avenue (APN 012-321-160) was a former redevelopment agency parcel; the Countywide Oversight Board approved its sale to Baden Development LLC for $1,100,000 on 2020-02-10, under a purchase agreement dated 2020-02-19. 428 Baden Avenue (APN 012-321-170) was owned by Baden Development LLC. The county parcel layer now shows the site as APN 012-321-290.",
      "src": [
        "SRC-003624"
      ]
    },
    {
      "text": "City funding list shows the $4,050,000 loan with Resolution 180-2021 and a Council date of October 13, 2020; the resolution itself records the Council vote on 2021-10-13.",
      "src": [
        "SRC-002106",
        "SRC-003624"
      ]
    },
    {
      "text": "Housing Choices listing describes 35 affordable units with 18 set aside for people with intellectual and developmental disabilities, managed by FPI Management.",
      "src": [
        "SRC-003625"
      ]
    }
  ],
