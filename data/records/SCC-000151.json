  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-22-536: The project, 777 West San Carlos , located at 266 & 270 Sunol Street & 777 West San Carlos in San Jose, requested and is being recommended for a reservation of $6,157,840 in annual federal tax credits and $19,913,930 in total state tax credits to finance the new construction of 153 units of housing serving families with rents affordable to households earning 30%-60% of area median income (AMI).",
      "src": [
        "SRC-001623"
      ]
    },
    {
      "text": "SJ Build shows 181 total units (154 under SB 35 permit H20-030 plus 27 under the State Density Bonus), against 154 in the state report and CTCAC.",
      "src": [
        "SRC-001931"
      ]
    },
    {
      "text": "City of San Jose permit H20-030 (Ministerial Permit, folder year 2020), status Approved, issue date 2021-08-13: \"SB 35 Streamlined Ministerial Permit to allow the demolition of 13,575 square feet of vacant buildings and construction of a 100% affordable rental project consisting of 154 residential units, a 2,500 square foot Child Care Center, an 82-space parking gar\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC CA-22-536: 16 units (10%) receive HUD Section 8 Project-based Vouchers; housing type Large Family; bond issuer City of San Jose; general partners Johnson & Johnson Investments, LLC and Community Revitalization and Development Corp.",
      "src": [
        "SRC-001623"
      ]
    },
    {
      "text": "SFYIMBY (2023-06-25): construction expected to cost over $100 million; one-third of units for extremely low-income, one-third very low-income, one-third low-income households; 154 bicycle spaces.",
      "src": [
        "SRC-002758"
      ]
    }
