  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001101",
        "SRC-001110"
      ]
    },
    {
      "text": "CTCAC CA-25-709: La Bella, located at 1020 Terra Bella Avenue in Mountain View on a 1.04 acre site, requested and is being recommended for a reservation of $4,603,926 in annual federal tax credits, $20,396,112 in total state tax credits, and $23,794,000 of tax-exempt bond cap to finance the new construction of 108 units of housing, consisting of 106 restricted rental units and 2 unrestricted manager's units.",
      "src": [
        "SRC-001669"
      ]
    },
    {
      "text": "REBusinessOnline, Oct. 12, 2026: six-story all-electric building; completion slated for second quarter 2028. Funders named: City of Mountain View, Santa Clara County Measure A, Santa Clara County Housing Authority, CTCAC, CDLAC, Wells Fargo Bank, Housing Trust Silicon Valley/Apple Affordable Housing Fund, Enterprise Community Partners and Cabretta Capital; amounts not stated.",
      "src": [
        "SRC-002969"
      ]
    },
    {
      "text": "Mountain View Voice: council approved the project on 2023-03-14; Public Storage donates 0.5 acre and reconfigures 1020 and 1040 Terra Bella Ave; city Housing Impact fund loan of $13.5 million supported in September 2022; two-level parking garage.",
      "src": [
        "SRC-002971"
      ]
    },
    {
      "text": "CEQAnet SCH 2022110590: Mitigated Negative Declaration received 2022-11-28 covering the land transfer, two storage buildings totaling 408,964 sq ft and the 108-unit housing; APNs 153-15-030, 153-15-002 and 153-15-021; 4.8 acres total, 1.04 acres residential.",
      "src": [
        "SRC-002972"
      ]
    },
    {
      "text": "Van Meter Williams Pollack: 106 units per acre on a 45,168 sq ft site; 10,800 sq ft landscaped patio; six 2- and 3-bedroom units with street-level stoops.",
      "src": [
        "SRC-002970"
      ]
    }
  ],
