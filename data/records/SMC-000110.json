  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001112",
        "SRC-001113"
      ]
    },
    {
      "text": "City of South San Francisco Planning Commission item 26-2309 refers to the project as 1400 Huntington Avenue, formerly known as 410 Noor Avenue.",
      "src": [
        "SRC-002328"
      ]
    },
    {
      "text": "C/CAG ALUC packet (June 2020): SyRES Properties applied in March 2018; 338 for-rent units (studio, one- and two-bedroom) in three 3-5 story buildings, parking in below-grade garages, on a 4.74-acre parcel at Noor and Huntington Avenues. ALUC staff found the project inconsistent with SFO ALUCP noise policies.",
      "src": [
        "SRC-002320"
      ]
    },
    {
      "text": "San Francisco Board of Supervisors Resolution 401-23 accepts an avigation easement from SyNoor LLC, owner of the 4.74-acre site, required by South San Francisco as a condition of approval after it overruled the ALUC.",
      "src": [
        "SRC-002322"
      ]
    },
    {
      "text": "BDE Architecture: 342 units in three buildings of 3 to 5 floors. Deacon: 262 market-rate apartments in two buildings (one with two below-grade podium levels and five Type III stories, one with one below-grade level and three Type V stories); owner SyNoor, LLC c/o SyRES Properties; status in progress.",
      "src": [
        "SRC-002325",
        "SRC-002323"
      ]
    }
