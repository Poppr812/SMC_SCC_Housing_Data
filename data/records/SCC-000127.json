  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-23-611: Villa Del Sol, located at 1936 Alum Rock Avenue in San Jose, requested and is being recommended for a reservation of $5,410,844 in annual federal tax credits to finance the new construction of 192 units of housing serving tenants with rents affordable to households earning 30%-70% of area median income (AMI).",
      "src": [
        "SRC-001644"
      ]
    },
    {
      "text": "City of San Jose permit CP17-052 (Conditional Use Permit, folder year 2017), status Approved, issue date 2019-03-27: \"Conditional Use Permit to allow a mixed-use project of a 39,000 square foot charter junior high school and 94 affordable, multi-family residential units with a State Density Bonus request (Concessions: reduction of residential recreation space requirement\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "City of San Jose permit CP20-015 (Conditional Use Permit/Amendment, folder year 2020), status Approved, issue date 2021-04-14: \"Conditional Use Permit to allow: The construction of a six-story mixed-use building with 3,000 square feet of commercial and podium parking on the ground floor and 194 units of 100% affordable multi-family units on the upper floors in the Alum Rock Urban\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "AO project page: 194 units on 1.49 acres (130.20 du/ac), 192 apartments for low-income families plus 2 manager units, six-story podium, mixed-use modular development, TCAC-funded, 30%-70% AMI; client Pacific West Communities.",
      "src": [
        "SRC-002623"
      ]
    },
    {
      "text": "Housing Action Coalition endorsement: developer The Pacific Companies, 194 homes affordable to 30%-80% AMI.",
      "src": [
        "SRC-002625"
      ]
    },
    {
      "text": "City building permits 2024-086346-MF (apartment) and 2024-086401-CI (mixed use) issued 2024-05-30 at 1928 Alum Rock Av; applicant Pacific West Builders Inc.",
