  "construction_notes": [
    {
      "text": "CTCAC CA-21-718: Kifer Senior Housing, located at 3335-3337 Kifer Road in Santa Clara, requested and is being recommended for a reservation of $2,415,301 in annual federal tax credits to finance the new construction of 79 income units of housing serving special needs tenants with rents affordable to households earning 20- 50% of area median income (AMI).",
      "src": [
        "SRC-001606"
      ]
    },
    {
      "text": "HCD (June 3, 2024): 80 homes; 46 units set aside for seniors experiencing homelessness or chronic homelessness with very low or extremely low incomes; more than $13 million from the Housing for a Healthy California program; services by Abode Services; managed by John Stewart Company.",
      "src": [
        "SRC-003207"
      ]
    },
    {
      "text": "Housing Trust Silicon Valley (May 9, 2024): 79 affordable apartments for seniors at 30-50% AMI; early funding from Housing Trust's TECH Fund with Google as capital partner, plus County Measure A Supportive Housing Fund; amounts not stated.",
      "src": [
        "SRC-003210"
      ]
    },
    {
      "text": "SF YIMBY (March 2021): 68-foot facade; replaces an 8,992 sq ft R&D building; GLO Architecture; rooftop solar; estimated construction cost $57.5 million; estimated completion May 2023.",
      "src": [
        "SRC-003209"
      ]
    },
    {
      "text": "The CTCAC staff report gives the address as 3335-3337 Kifer Road; the county parcel data and Silicon Valley Voice give 3333 Kifer Road.",
      "src": [
        "SRC-001606",
        "SRC-001098",
        "SRC-003208"
      ]
    }
  ],
