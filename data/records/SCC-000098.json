  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099"
      ]
    },
    {
      "text": "CTCAC CA-25-715: Block A Family Apartments, located at 860 West San Carlos Street in San Jose on a 2.17 acre site, requested and is being recommended for a reservation of $5,714,173 in annual federal tax credits and $38,000,000 of tax-exempt bond cap to finance the new construction of 272 units of housing, consisting of 269 restricted rental units and 3 unrestricted manager's units.",
      "src": [
        "SRC-001670"
      ]
    },
    {
      "text": "City of San Jose permit H25-045 (Site Development Permit/Amendment, folder year 2025), status Approved, issue date 2026-05-20: \"Site Development Permit to allow the construction of a seven-story multifamily building with 272 dwelling units (100% affordable; with 55 units reserved for very-low-income households earning up to 50% of Area Median Income and 217 units reserved for low-\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "SF YIMBY (2026-03-02): 79 ft, seven stories (five wood floors over a two-story concrete podium), about 425,700 sq ft, 242-car garage, 76 bicycle spaces; Swenson is developer and design architect, Republic Urban Properties joint venture partner, HMH civil engineering and landscape architecture. Prior 2022 design by Steinberg Hart was a 12-story, 263-unit complex. Third and final phase after Silver at Ohlone (268 units) and Patina@Midtown (269 units).",
      "src": [
        "SRC-001392"
      ]
    },
    {
      "text": "SF YIMBY (2024-09-06): plans shifted from mostly market-rate to fully affordable, 272 units, up from a prior 12-story application for 251 or 263 apartments with ground-floor retail that the city approved in 2021; article cites an estimated $400 million for the overall three-phase development.",
      "src": [
        "SRC-002463"
      ]
    }
  ],
