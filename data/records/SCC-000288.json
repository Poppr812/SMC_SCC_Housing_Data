  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-25-054: Santa Teresa Multifamily, located at 5885 Santa Teresa Boulevard in San Jose, requested and is being recommended for a reservation of $2,500,000 in annual federal tax credits and $6,410,282 in total state tax credits to finance the new construction of 48 units of housing serving families and special needs tenants with rents affordable to households earning 30%-50% of area median income (AMI).",
      "src": [
        "SRC-001658"
      ]
    },
    {
      "text": "City of San Jose permit MP22-009 (Ministerial Permit, folder year 2022), status Approved, issue date 2023-04-21: \"SB 35 Ministerial Permit (MP22-009) to allow for the of the demolition of an existing parking lot and construction of three (3) new buildings (3-stories each) of 100% affordable housing project consisting of 49 for-rent apartment units, removal of 18 tre\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC CA-25-054: 3 residential buildings; 21 units with HUD Section 8 project-based vouchers; 24 special-needs units (homeless); construction cost $738 per sq ft; per-unit cost $926,430; construction-period sources also include deferred costs of $3,010,043 and tax credit equity of $2,513,951; approved developer fee $2,800,000.",
      "src": [
        "SRC-001658"
      ]
    },
    {
      "text": "San Jose Spotlight (June 24, 2024): $7.3 million in city Measure E funds; more than $4 million from Santa Clara County; $720,000 from the Federal Home Loan Bank of New York; bank loan of about $6.6 million; projected private equity of $26.7 million; Santa Clara County Housing Authority more than $19 million for 21 rent-subsidy vouchers; 520 sq ft community room with full kitchen and food pantry; rapid rehousing for families exiting homelessness.",
      "src": [
        "SRC-003499"
      ]
    }
  ],
