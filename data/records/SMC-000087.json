  "construction_notes": [
    {
      "text": "Demolishes an existing office building; a modification application adds two exterior staircases and design changes",
      "src": [
        "SRC-001056"
      ]
    },
    {
      "text": "Project name on the plans and in SF YIMBY: Pioneer Vista Townhomes. The plan set describes the units as condominiums with separate entrances, six facing Pioneer Ct and four reached from the rear; lot size 19,321 sq ft; building height 43 ft 10 in; construction type V-A; unit 8 (TD1) is the BMR unit. SF YIMBY gives about 34,560 sq ft and calls the units apartments; the city page gives about 35,120 sq ft.",
      "src": [
        "SRC-004069",
        "SRC-004068",
        "SRC-001056"
      ]
    },
    {
      "text": "CEQA notice for PA-2025-040 names Jack Boyajian, President, The Hutton Group, as applicant; the notice for modification PA-2026-0067 names Jack Boyajian, President, 2015 Pioneer LLC. The STILL Property Group site says its conversion practice was pioneered by Jack Boyajian and continued through The Hutton Group; it does not list this project.",
      "src": [
        "SRC-004067",
        "SRC-004070",
        "SRC-004071"
      ]
    }
