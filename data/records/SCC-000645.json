  "construction_notes": [
    {
      "text": "State APR Gilroy 2018 Table A2 row named Town Center (Miller Ave., APN 808-18-003, 22, 23) lists 158 rental units entitled 2018-09-19: 16 very low-income and 142 low-income deed-restricted, LIHTC, 55-year term. CTCAC CA-20-900 (2020-04-14) describes Glen Loma Ranch Apartments, north of W. Luchessa Ave. between W. 10th St. and Miller Ave., Gilroy: 158 units, 156 low-income, developer Pacific West Communities, Inc.",
      "src": [
        "SRC-001138",
        "SRC-002680"
      ]
    },
    {
      "text": "CTCAC CA-20-900: 10 residential buildings, new construction, census tract 5125.09, federal set-aside 40%/60% average income, tax-exempt bonds issued by CalHFA. Land contributed for $1,000. Per-unit cost $512,949. Approved developer fee $9,000,000.",
      "src": [
        "SRC-002680"
      ]
    },
    {
      "text": "State APR Gilroy 2020 Table A2 lists building permits issued 2020-06-11 under APN 808-19-023 for ten addresses at 1301-1345 W Luchessa Ave, named Glen Loma Ranch BMR Apartments (Community Resources), each with 15 to 18 units, with very low- and low-income deed-restricted units and a 55-year regulatory agreement. APN 808-19-023 is not in the current county parcel dataset.",
      "src": [
        "SRC-001138"
      ]
    }
