  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001120"
      ]
    },
    {
      "text": "Redevelopment of the Los Gatos Meadows senior community, operated 1971 to 2019 and closed for safety reasons. Owner Front Porch merged with the prior operator, Covia, in 2021. Front Porch's site names the new community Fresco Los Gatos.",
      "src": [
        "SRC-002605",
        "SRC-002607",
        "SRC-002611"
      ]
    },
    {
      "text": "Front Porch FAQ (July 2025): construction documents and permits about 18 months, construction not expected to start until early 2027 and lasting about two and a half years, reopening targeted for late 2029. Hazardous-material removal starting July 2025.",
      "src": [
        "SRC-002605"
      ]
    },
    {
      "text": "2021 Draft EIR version: eight three- to five-story buildings, 174 independent apartments (57 one-bedroom, 117 two-bedroom), 17 supporting care units and 77 parking spaces.",
      "src": [
        "SRC-002608"
      ]
    },
    {
      "text": "Los Gatan reports parking in an underground base beneath the villas, removal of 192 trees, and the developer's statement that it is not a Builder's Remedy project. Its subtitle says 185 independent units; its body cites 187.",
      "src": [
        "SRC-002607"
      ]
    }
  ],
