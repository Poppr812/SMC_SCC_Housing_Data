  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "January 2023 announcement of Vela, 87 homes in Mayfair, Alum Rock, by Affirmed Housing. No street address on that page; probably this project, which would have finished before 2024.",
      "src": [
        "SRC-001844"
      ]
    },
    {
      "text": "City of San Jose permit CP18-044 (Conditional Use Permit, folder year 2018), status Approved, issue date 2020-01-14: \"Conditional Use Permit to allow the demolition of an existing commercial building (9,061-sf) and surface parking lot, and construction a mixed-use multi-family residential building with 87 affordable housing units and 3,000 square feet of commercial space\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC CA-20-569 (April 14, 2020), project name Alum Rock Family Housing at 2350 Alum Rock Avenue: 87 units, 85 restricted, special needs housing type, HUD Section 8 project-based vouchers for 29 units, bond issuer City of San Jose, total project cost at application $66,623,139 (about $744,160 per unit). Construction sources: Banner Bank $36,855,974, City of San Jose $1,000,000, Santa Clara County $13,117,165, tax credit equity $15,650,000.",
      "src": [
        "SRC-003104"
      ]
    },
    {
      "text": "Grand opening release: 87 homes in the Mayfair neighborhood; 43 homes for formerly unhoused residents (14 rapid rehousing, 29 permanent supportive); rents for households up to 30% and 60% AMI; on-site services by PATH; City of San Jose and Santa Clara County (Measure A) funding; Bank of America financing; CCRC named as a partner.",
      "src": [
        "SRC-003103"
      ]
    },
    {
      "text": "County parcel data lists situs 2358 Alum Rock Av for APN 484-41-168. The state report's 2018 application row lists APN 484-41-165, which does not appear in current county parcel data.",
      "src": [
        "SRC-003105",
        "SRC-001099"
      ]
    }
