  "construction_notes": [
    {
      "text": "First phase of a three-phase master plan expected to exceed 400 units. Captions also cite 1197 Lick Avenue.",
      "src": [
        "SRC-001372"
      ]
    },
    {
      "text": "CTCAC CA-22-552: Tamien Station Affordable, located at 1197 Lick Avenue in San Jose, requested and is being recommended for a reservation of $6,084,890 in annual federal tax credits to finance the new construction of 134 units of housing serving special needs and large family tenants with rents affordable to households earning 30%-60% of area median income (AMI).",
      "src": [
        "SRC-001624"
      ]
    },
    {
      "text": "CTCAC CA-26-616: Tamien Station Phase II, located at 1221 Lick Avenue & 1184 Lelong Street in San Jose on a 1.92 acre site, requested and is being recommended for a reservation of $5,095,713 in annual federal tax credits, $9,979,182 in total state tax credits, and $27,050,000 of tax-exempt bond cap to finance the new construction of 132 units of housing, consisting of 131 restricted rental units and 1 unrestricted manager's unit. Recorded as a note because this funding covers Tamien Station Phase II (132 units), which may be one component of this record.",
      "src": [
        "SRC-001625"
      ]
    }
