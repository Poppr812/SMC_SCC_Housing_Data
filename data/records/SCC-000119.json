  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001107"
      ]
    },
    {
      "text": "237 and 253 Race Street: Bellarmino Place 116 units, Alvarado Park 90 senior units.",
      "src": [
        "SRC-001396"
      ]
    },
    {
      "text": "CTCAC CA-22-001: Bellarmino Place, located at 230, 246, 250, and 260 Grand Avenue, and 253, 245 Race Street in San Jose, requested and is being recommended for a reservation of $2,500,000 in annual federal tax credits to finance the new construction of 115 units of housing serving large families with rents affordable to households earning 30%-60% of area median income (AMI). Recorded as a note because this funding covers Bellarmino Place (116 units), which may be one component of this record.",
      "src": [
        "SRC-001617"
      ]
    },
    {
      "text": "CTCAC CA-23-007: Alvarado Park, located at 237 Race Street in San Jose, requested and is being recommended for a reservation of $2,500,000 in annual federal tax credits to finance the new construction of 89 units of housing serving seniors with rents affordable to households earning 30%-60% of area median income (AMI). Recorded as a note because this funding covers Alvarado Park (90 units), which may be one component of this record.",
      "src": [
        "SRC-001618"
      ]
    },
    {
      "text": "City of San Jose permit PD18-043 (PD Permit, folder year 2018), status Approved, issue date 2020-08-19: \"Planned Development Permit to allow the demolition of 13 structures and the construction of 206 affordable housing units within two buildings (a 116-unit M-F apartment building, and a 90-unit Senior Housing building), 2,000 square feet of commercial retai\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC CA-22-001, Bellarmino Place (June 2022): 116 units (57 one-bedroom, 30 two-bedroom, 29 three-bedroom); 115 tax credit units: 53 at 30% AMI, 52 at 50%, 10 at 60%, plus one manager's unit; HUD project-based vouchers on 53 units; total project cost $97,893,417 ($835,579 per unit), attributed in part to soil remediation; management agent John Stewart Company.",
      "src": [
        "SRC-001617"
      ]
    },
    {
      "text": "CTCAC CA-23-007, Alvarado Park (July 2023): 90 units (82 one-bedroom, 8 two-bedroom); 89 tax credit units: 41 at 30% AMI, 41 at 50%, 7 at 60%, plus one manager's unit; HUD project-based vouchers on 41 units; total project cost $69,331,902 ($770,354 per unit), attributed to demolition and abatement, covered podium parking and EV charging.",
      "src": [
        "SRC-001618"
      ]
    },
    {
      "text": "San José Spotlight, September 2025: Bellarmino Place cost nearly $97 million, with over $10 million from Santa Clara County, $34 million from the Housing Authority and $52 million from Wells Fargo; 24 apartments for formerly homeless households. Alvarado Park cost nearly $70 million, with $10 million from the county, nearly $22 million from the Housing Authority and $24 million from Enterprise; 23 apartments for people at risk of homelessness. The county's $20 million for the two came from Measure A.",
      "src": [
        "SRC-002654"
      ]
    },
    {
      "text": "Dahlin Group lists itself as architect of both buildings (architecture and interior design for Bellarmino Place) and gives the Alvarado Park site as 2.3 acres.",
      "src": [
        "SRC-002653",
        "SRC-002655"
      ]
    }
  ],
