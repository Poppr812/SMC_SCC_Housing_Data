  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "City of San Jose permit H20-001 (Site Permit, folder year 2020), status Approved, issue date 2020-10-19: \"AB 2162 Streamlined Ministerial Permit to allow the demolition of an existing commercial building and the construction of a 91-unit residential development, with 59 units reserved for permanent supportive housing, with a State Density Bonus Request for tw\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "The December 2021 CTCAC staff report (CA-21-706) lists Reed Community Partners LLC as developer, general partners Reed Realty Advisors LLC and Allied 2095 Evans LLC, City of San Jose as bond issuer, and 46 HUD Section 8 project-based vouchers. Its permanent sources were Specialty Finance Group tax-exempt loan $11,157,588, Santa Clara County Measure A $11,500,000, City of San Jose $10,500,000, deferred developer fee $4,650,892 and tax credit equity $25,614,615. The project does not appear in CTCAC's Active Projects list through 2025.",
      "src": [
        "SRC-003075",
        "SRC-001603"
      ]
    },
    {
      "text": "San Jose Spotlight (August 2025): Santa Clara County contributed nearly $36 million, including $22 million of Measure A; Homekey+ provided $40 million; completion expected October 2027.",
      "src": [
        "SRC-003077"
      ]
    },
    {
      "text": "Developer page lists financing partners County of Santa Clara, HCD Homekey+, HCD NPLH, WPC, Housing Authority, AHP and VA, and expects completion in late 2027.",
      "src": [
        "SRC-001975"
      ]
    }
