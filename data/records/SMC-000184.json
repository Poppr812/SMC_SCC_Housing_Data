  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001132",
        "SRC-001133"
      ]
    },
    {
      "text": "City staff report (Aug 9, 2021): lot split of the existing 28,333 SF lot at 1418 Bellevue Avenue. Parcel 1 (18,951 SF) keeps the existing four-story, 49-unit apartment building; the new six-story, 15-unit condominium building with an enclosed at-grade garage goes on Parcel 2 (9,832 SF). APN 029-112-350 covers the whole existing lot.",
      "src": [
        "SRC-003966"
      ]
    },
    {
      "text": "City staff report: 15 units on five floors above a ground-floor garage and lobby, plus a rooftop terrace; unit sizes 696 to 1,520 SF. SF YIMBY reports unit sizes of 700 to 1,520 SF and a height of 75 feet.",
      "src": [
        "SRC-003966",
        "SRC-003967"
      ]
    },
    {
      "text": "City staff report: project found Categorically Exempt under CEQA Section 15332 (Class 32 infill). Legistar matter 20-0225 (2020) was an environmental scoping item for the same 15-unit condominium.",
      "src": [
        "SRC-003966",
        "SRC-003968"
      ]
    }
