  "construction_notes": [
    {
      "text": "Parcel match: CEQA APN 170-04-066 isn't in county data. 170-04-068 (2.38 ac) and 170-04-069 (1.39 ac) total about the stated 3.8 acres, next to 5084 El Camino Real. Matched by block, location and area, not the source's own APN.",
      "src": [
        "SRC-001889"
      ]
    },
    {
      "text": "June 2022 Planning Commission report: the modification splits the site into two lots. Lot 1 holds two five-story buildings along El Camino Real with 172 rental units; Lot 2 holds 24 townhouse units to be sold as condominiums. The 2019 approval was for 196 condominium units. Parcel size 3.8 acres (165,345 sq ft); 52 du/ac.",
      "src": [
        "SRC-002641"
      ]
    },
    {
      "text": "Prometheus markets the 172 apartments as Harken at 5160 El Camino Real, Los Altos, with one- and two-bedroom plans averaging 1,134 sq ft.",
      "src": [
        "SRC-002642"
      ]
    },
    {
      "text": "SF YIMBY (2025-06-20): the site was originally proposed by a different developer; after a 2021 loan default, a legal ruling allowed Prometheus to buy the property.",
      "src": [
        "SRC-001888"
      ]
    }
