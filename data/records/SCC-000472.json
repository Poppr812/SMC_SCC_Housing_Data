  "construction_notes": [
    {
      "text": "Both APNs carry the 280 Lambert address in county data. City page shows no formal application.",
      "src": [
        "SRC-001272"
      ]
    },
    {
      "text": "SB 330 plan set (2023-03-10): five stories (Type V-B over Type II podium), 65 ft, FAR 2.98:1, two basement levels with 85 parking stalls and 70 bike racks; 9 BMR units (20%) reserved for low-income households; demolition of about 10,740 sq ft of 1968 and 1970 automotive repair buildings. Plan lists APNs 132-38-060 and 132-38-061.",
      "src": [
        "SRC-003523"
      ]
    },
    {
      "text": "2021 prescreening concept (49 units): a 35-ft building with 10 townhouse-style condominiums and a five-story building with 39 condominiums, replacing 10,125 sq ft of automobile service buildings; rezoning from CS to Planned Home Zoning; no formal Council action at the study session.",
      "src": [
        "SRC-003525"
      ]
    },
    {
      "text": "City project page lists SB 330 pre-application 23PLN-00073 submitted 2023-03-22 and states the formal application is due within 180 days of a complete pre-application; the page shows no formal application.",
      "src": [
        "SRC-001272"
      ]
    },
