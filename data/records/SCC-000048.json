  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "The design approved in 2022 had two towers: Echo, 27 stories and 415 apartments, and Icon, 24 stories with about 525,000 sq ft of office and up to 8,500 sq ft of retail. San Jose Spotlight reported that design provided no on-site below-market-rate units, received an affordable housing fee waiver and 50% construction tax reduction under the downtown high-rise incentive program, and that the developer was investing $10 million in the Town Park Towers senior affordable complex.",
      "src": [
        "SRC-002076"
      ]
    },
    {
      "text": "REBusinessOnline (March 2024) described a 21-story office tower and 27-story residential tower on a shared four-story podium with 1,000 below-grade parking spaces.",
      "src": [
        "SRC-002075"
      ]
    },
    {
      "text": "The 2026 Notice of Exemption covers demolition of all existing buildings (about 22,527 sq ft), removal of 29 trees, about 1,320 sq ft of commercial space, and lists APNs 467-20-079, 467-20-081, 467-20-060 and 467-20-080.",
      "src": [
        "SRC-002073"
      ]
    },
    {
      "text": "Urban Catalyst's Echo page shows 315 homes in eight stories at 95 N. 4th Street as the northern portion of the Icon/Echo block, with status Planning Permit Approved.",
      "src": [
        "SRC-002074"
      ]
    }
  ],
