  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001101",
        "SRC-001110"
      ]
    },
    {
      "text": "City Council approved 6-1 on Nov. 18, 2025 (Resolution No. 19054), John McAlister dissenting; the council kept the two-year permit term rather than the eight years the applicant requested. About 180 feet tall; 19 heritage trees removed.",
      "src": [
        "SRC-002233",
        "SRC-002232"
      ]
    },
    {
      "text": "Council report: replaces a two-story duplex and three storage structures; building about 542,306 sq ft total; 91 low-income units (20%) and 364 market-rate; density 362 units per acre; lists Mario Ambra as applicant and owner.",
      "src": [
        "SRC-001693"
      ]
    },
    {
      "text": "CEQA notice: 356 bicycle spaces; 67 trees removed and 52 planted; includes a lot line adjustment; anticipated construction April 2028 to October 2030. The notice lists APNs 193-02-049 and 193-02-050.",
      "src": [
        "SRC-002231"
      ]
    },
    {
      "text": "Proposed settlement after a legal dispute: zoning permits and lot line adjustment valid four years from Nov. 18, 2025, so building permits and construction must start by Nov. 18, 2029, with one possible two-year extension; the applicant's density bonus concessions are deemed fully satisfied.",
      "src": [
        "SRC-002230",
        "SRC-002232"
      ]
    }
