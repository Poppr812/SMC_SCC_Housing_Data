  "construction_notes": [
    {
      "text": "Conformance letter (ZCP23-047, 2023-12-01): six-story, 79-unit 100% affordable senior building with 30 parking spaces and 33 bicycle spaces on a vacant 0.654-acre lot in the Ravenswood Specific Plan area, zoned Urban Residential; streamlined to the Building Division under SB 35; subject to an AB 168 enforceable agreement with the Tamien Nation on tribal cultural resources.",
      "src": [
        "SRC-003237"
      ]
    },
    {
      "text": "Plan set: five-story wood-frame over a one-story concrete podium, 62 ft to roof sheathing, stair penthouse to 73 ft 10 in; units by floor 2nd 13, 3rd-5th 17 each, 6th 14, plus the ground-floor manager unit.",
      "src": [
        "SRC-003239"
      ]
    },
    {
      "text": "State report 2025 notes: SB 35, 79-unit affordable senior apartments, part of the Euclid Improvements project inclusionary requirement.",
      "src": [
        "SRC-001111"
      ]
    },
    {
      "text": "The Almanac (September 2026): Sand Hill had proposed contributing $23 million to affordable housing at 851 Weeks Street instead of setting aside units in its own project, then proposed redirecting $14 million to a teacher housing project.",
      "src": [
        "SRC-003242"
      ]
    }
