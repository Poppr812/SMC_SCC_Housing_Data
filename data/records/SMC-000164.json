  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001147"
      ]
    },
    {
      "text": "City and CEQA filings describe a four-story, 47,594 sq ft mixed-use building at the northwest corner of University Ave and Runnymede St with ground-floor retail (about 2,500 sq ft), parking and a residential lobby, and 33 units above. The parcels would be combined into one 38,905 sq ft lot; the city page lists APNs 063-201-250, 260 and 290 and says four parcels; the CEQA notice says three. Zoning MUC-2.",
      "src": [
        "SRC-001208",
        "SRC-003681"
      ]
    },
    {
      "text": "Palo Alto Daily Post (2020-05-19): developer John Suppes of Palo Alto-based Clarum Homes; 33 apartments with 7 affordable (4 at 80% AMI, 3 at 120% AMI); four stories, 59.5 feet; 75 parking spaces; 5,150 sq ft ground-floor lobby; Clarum has owned the lot since 2007, and a tenant relocation agreement required council approval. The state report lists owner tenure.",
      "src": [
        "SRC-003680",
        "SRC-001147"
      ]
    }
