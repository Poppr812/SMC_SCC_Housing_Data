  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "Matched on Boston Avenue frontage and 61 condominiums; the state report gives 17 Boston Av. Parcel 274-16-051 is county data for 1881 W San Carlos St. Plan also has 246 senior units.",
      "src": [
        "SRC-001865"
      ]
    },
    {
      "text": "CEQAnet NOP (Dec 2020): four planning applications including CP20-020; up to seven stories, about 187,400 sq ft, 157-bed residential care facility for the elderly, 61 multifamily units, 6,000 sq ft retail, car lifts; addresses 1883, 1891 and 1899 West San Carlos Street and 13 and 17 Boston Avenue; APNs 274-16-049, -050, -051, -052, -053, -069, -070. City contact Reema Mahamood.",
      "src": [
        "SRC-003390"
      ]
    },
    {
      "text": "CEQAnet Draft EIR (Jul 2022): seven stories, 209,522 sq ft; RCFE of 125,451 sq ft with 246 beds (157 beds in the Development Types section); 61 multifamily units; up to 67 condominiums including 61 residential, four commercial and two parking garage units; stacker parking on ground floor and basement.",
      "src": [
        "SRC-003388"
      ]
    },
    {
      "text": "SFYIMBY (Sep 2023): about 227,620 sq ft total, 125,260 sq ft senior care, 78,070 sq ft housing, 6,000 sq ft in four retail spaces, 18,280 sq ft parking; 113 cars in stackers and 75 bicycles; replaces four commercial structures.",
      "src": [
        "SRC-001865"
      ]
    },
    {
      "text": "BVNA (Aug 2020): seven parcels at 1881-1899 West San Carlos St and 13-17 Boston Ave; 2020 plans showed a six-story building with 61 condos including 13 two-bedroom townhome units on the sixth floor, and a five-story senior care building with 151 assisted living and memory care rooms; owner Dorsa Family Trust of Los Gatos per the June 4 plan set.",
      "src": [
        "SRC-003389"
      ]
    }
  ],
