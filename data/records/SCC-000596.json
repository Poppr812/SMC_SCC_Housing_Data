  "construction_notes": [
    {
      "text": "Parcel match: city APN 326-27-043 and CEQA APNs 326-27-039 to -041 aren't in county data. County situs 21255 and 21265 Stevens Creek adjoin the city's 21267 at the former Oaks center. Townhome lots were likely subdivided off and aren't attached here. Matched by address, not the source's own APN.",
      "src": [
        "SRC-001882",
        "SRC-001884"
      ]
    },
    {
      "text": "Senior affordable building: six stories, 48 units (9 studios, 28 one-bedroom, 11 two-bedroom, including 1 manager unit), for seniors earning up to 60% AMI. CTCAC application cost $37,122,256, including a $9,119,900 land donation as a source.",
      "src": [
        "SRC-002490",
        "SRC-002491"
      ]
    },
    {
      "text": "2024 modification (M-2024-003, ASA-2024-003): Building 1 residential units from 123 to 136, basement parking garage eliminated, ground-floor retail from about 12,000 to 4,000 sq ft. Building 1 also has 35 memory care rooms.",
      "src": [
        "SRC-001882"
      ]
    },
    {
      "text": "San Jose Spotlight, Feb. 2024: affordable rents $889 to $2,534 per month by unit size; move-ins expected early March 2024.",
      "src": [
        "SRC-002488"
      ]
    }
  ],
