  "construction_notes": [
    {
      "text": "135 single-family homes and 38 duplexes. County: incomplete determination June 26, 2025, appeal denied by Planning Commission August 28, 2025.",
      "src": [
        "SRC-001431"
      ]
    },
    {
      "text": "HCD states the County treats the preliminary application as expired after one 90-day resubmittal period; HCD found that interpretation violates the Permit Streamlining Act. The County replied on 2025-09-23 that it maintains its position.",
      "src": [
        "SRC-002705",
        "SRC-002707"
      ]
    },
    {
      "text": "YIMBY Law lists the case as active, with a hearing expected 2026-12-14.",
      "src": [
        "SRC-002704"
      ]
    },
    {
      "text": "Site lies between Alamitos Creek and Calero Creek. Green Foothills states one end is in a FEMA flood and liquefaction zone, the other in a fault rupture hazard zone, and the whole site in a high fire severity zone.",
      "src": [
        "SRC-002706"
      ]
    },
    {
      "text": "SF YIMBY credits the site map to Lawrence E. Stone and describes a private street network, wastewater facilities and common open space.",
      "src": [
        "SRC-002703"
      ]
    }
  ],
