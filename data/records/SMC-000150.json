  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001117",
        "SRC-001116"
      ]
    },
    {
      "text": "Nine three-story wood-framed buildings; two-, three- and four-bedroom townhomes of roughly 1,200 to 1,700 sq ft (CEQAnet, SF YIMBY) or roughly 1,300 to 1,850 sq ft (The Registry, July 2023); two-car garages; all-electric with solar and EV charging.",
      "src": [
        "SRC-003427",
        "SRC-003428",
        "SRC-003429"
      ]
    },
    {
      "text": "The 2.54-acre site was home to Alan Steel; the development caps PCB-contaminated soil under a plan approved by the Regional Water Quality Control Board and U.S. EPA.",
      "src": [
        "SRC-003429",
        "SRC-003430"
      ]
    },
    {
      "text": "BCDC: about 1.39 acres lie in Commission jurisdiction (0.15 acres in the Bay, 1.24 acres in the shoreline band), including three buildings with 20 townhomes; the permit requires 14,254 sq ft of dedicated public access, 6,426 sq ft of dedicated open space, a shoreline trail with overlooks, 5 public shore parking spaces and trail connections to the Bair Island trail network and the adjacent 557 East Bayshore Road project.",
      "src": [
        "SRC-003430"
      ]
    },
    {
      "text": "BCDC May 16, 2024: motion by Commissioner Addiego to approve the staff recommendation carried 14-0-1, Commissioner Kimball abstaining.",
      "src": [
        "SRC-003431"
      ]
    }
  ],
