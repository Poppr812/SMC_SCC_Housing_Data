  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001131"
      ]
    },
    {
      "text": "Planning Commission Resolution 24-10 approved a 7-lot tentative subdivision map on an 8.37-acre site north of East Dunne Avenue and Saddleback Drive (APNs 728-02-002 and 728-02-003). Lots range from about 43,571 to 51,890 sq ft: three 3,463 sq ft four-bedroom homes and four five-bedroom homes of 4,631 to 5,300 sq ft. Sorrel Way and Saddleback Drive extend into the site to a new Kole Court; three homes take access from a 25-foot private driveway off Saddleback Drive.",
      "src": [
        "SRC-004165",
        "SRC-001455",
        "SRC-004166"
      ]
    },
    {
      "text": "City of Morgan Hill is CEQA lead agency; a Mitigated Negative Declaration was filed with the State Clearinghouse as SCH 2024080017.",
      "src": [
        "SRC-004167",
        "SRC-004166"
      ]
    },
    {
      "text": "The county parcel layer shows APN 728-02-002 as a sliver of about 29 sq ft inside APN 728-02-003, which holds the rest of the site.",
      "src": [
        "SRC-001098"
      ]
    }
