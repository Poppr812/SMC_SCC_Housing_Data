  "construction_notes": [
    {
      "text": "The site previously held four affordable units operated by MidPen Housing (Almanac). SF YIMBY reports the project requires demolition of an existing single-family house.",
      "src": [
        "SRC-004151",
        "SRC-004150"
      ]
    },
    {
      "text": "In August 2026 the City Council declined Habitat's request to waive development impact and permitting fees and asked Habitat to resubmit closer to when fees are due. Habitat estimated the fees at about $944,000; the city estimated about $596,000.",
      "src": [
        "SRC-004152"
      ]
    },
    {
      "text": "Habitat sought waivers from city standards including minimum land area per unit, setbacks, floor area ratio, parking and driveway requirements. The Council approved a vesting tentative map combining the parcels at 335 and 355 Pierce Road.",
      "src": [
        "SRC-004151",
        "SRC-004152"
      ]
    },
    {
      "text": "City page lists staff contact Calvin Chan, Senior Planner, and shows the next step as a building permit application. Habitat's page says the project is in the building permit process.",
      "src": [
        "SRC-001189",
        "SRC-001978"
      ]
    }
  ],
