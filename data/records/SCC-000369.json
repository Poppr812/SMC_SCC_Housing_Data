  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001134",
        "SRC-001143"
      ]
    },
    {
      "text": "16 townhomes replacing two duplexes. The city moved this case to its inactive list and shows it as Project Closed, last updated 2026-01-22. The city's data does not say how it was decided.",
      "src": [
        "SRC-001551"
      ]
    },
    {
      "text": "Planning Commission approved the project on Nov. 25, 2025 by roll call 6-0 (Zisser, Alne, Buchbinder, Aquilina, Fields, Kamkar); motion by Fields, second by Zisser. Commission action is final unless appealed within 10 days. CEQA: Class 32 infill categorical exemption.",
      "src": [
        "SRC-003961",
        "SRC-003958"
      ]
    },
    {
      "text": "Three townhome buildings of 5, 5 and 6 units (7,405, 7,865 and 4,020 sq ft as listed in the staff report table), 37 ft maximum height, contemporary Mediterranean design, private garages off a central driveway from Michael Drive. Density 29.3 to 29.46 units per acre in the staff report. The tentative map creates 16 residential lots and one common lot.",
      "src": [
        "SRC-003958"
      ]
    }
