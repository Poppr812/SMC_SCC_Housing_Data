  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001105"
      ]
    },
    {
      "text": "CTCAC CA-25-807: The project, 493 Eastmoor Ave., located at 493 Eastmoor Avenue in Daly City on a 0.37 acre site, requested and is being recommended for a reservation of $3,461,599 in annual federal tax credits and $18,300,000 of tax- exempt bond cap to finance the new construction of 72 units of housing, consisting of 71 restricted rental units and 1 unrestricted manager's unit.",
      "src": [
        "SRC-001672"
      ]
    },
    {
      "text": "San Mateo County AHF predevelopment pipeline, September 2024: 493 Eastmoor (Core Company): 71 total units, 76% at 15-30% AMI and 24% at 31-60% AMI.",
      "src": [
        "SRC-001649"
      ]
    },
    {
      "text": "HUD environmental assessment: 70,399 gross sq ft new mixed-use building on a 0.37-acre vacant lot at the northwest corner of Eastmoor and Sullivan Avenues; 35 studios, 36 one-bedroom and 1 two-bedroom on floors 3-7; 32 parking spaces including 4 Level 2 and 28 Level 1 EV chargers.",
      "src": [
        "SRC-003288"
      ]
    },
    {
      "text": "Daly City residential project list (5/27/2026): status in plan check; City Council approved 2020-02-24; time extension granted to 2026-02-24.",
      "src": [
        "SRC-001158"
      ]
    },
    {
      "text": "CTCAC CA-25-807: construction cost $1,155 per sq ft; developer fee $4,800,000; state funding from HCD IIG and PLHA and DHCS MHSA; homeless set-aside.",
      "src": [
        "SRC-001672"
      ]
    }
