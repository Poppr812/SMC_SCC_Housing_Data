  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001118",
        "SRC-001119"
      ]
    },
    {
      "text": "Special Development Permit approved by the Planning Commission September 9, 2024: a six-story senior housing building with 113 independent living units, 36 assisted living accommodations and about 12,232 sq ft of commercial space, plus a three-story, 72,000 sq ft, 52-bed convalescent hospital, replacing two used auto sales buildings on one 2.42-acre parcel.",
      "src": [
        "SRC-001517",
        "SRC-002926"
      ]
    },
    {
      "text": "Sources differ on the hospital building: the city filing shows three stories and 72,000 sq ft; SF YIMBY (September 2024) shows about 63,000 sq ft, 59 feet tall, three stories; SF YIMBY (April 2025) shows four stories. SF YIMBY (September 2024) shows the senior building at 75 feet with a 2.5-level basement garage.",
      "src": [
        "SRC-001517",
        "SRC-002927",
        "SRC-001516"
      ]
    },
    {
      "text": "San Jose Spotlight (September 2024): Watermark Retirement Communities to operate the senior living building and El Camino Health the convalescent hospital; about 12,000 sq ft of ground-floor retail planned as a fitness center and cafe; PMB targeted a November construction start and an end-of-2026 opening.",
      "src": [
        "SRC-002925"
      ]
    },
    {
      "text": "WATG project page: 203,000 sq ft mixed-use project with 149 units (113 independent living, 36 assisted living), targeting LEED Gold.",
      "src": [
        "SRC-002924"
      ]
    }
  ],
