  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001129",
        "SRC-001123"
      ]
    },
    {
      "text": "CTCAC CA-24-521: View at San Bruno, located at 840 San Bruno Avenue West in San Bruno on a 1.57 acre site, requested and is being recommended for a reservation of $10,871,877 in annual federal tax credits and $125,000,000 of tax- exempt bond cap to finance the new construction of 341 units of housing, consisting of 337 restricted rental units, and 4 unrestricted manager's units.",
      "src": [
        "SRC-001652"
      ]
    },
    {
      "text": "CTCAC staff report: two residential buildings, Type I construction; census tract 6041.02; tax credit investor Berkadia at a federal credit factor of $0.84; land and acquisition cost $21,501,900; construction cost per square foot $442; staff noted a per unit development cost of $694,293.",
      "src": [
        "SRC-001652"
      ]
    },
    {
      "text": "SF YIMBY: Building A has 204 units and Building B has 137 units; each building is 10 stories and 102 feet tall. The site held a single-story commercial building and surface parking.",
      "src": [
        "SRC-002319"
      ]
    },
    {
      "text": "CEQA Notice of Exemption filed by the City of San Bruno on 2023-11-17 (SCH 2023110467) for demolition of the existing structure and construction of two 10-story residential buildings with 337 affordable rental units and four manager's units, APN 020-071-050.",
      "src": [
        "SRC-002318"
      ]
    }
  ],
