  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "City of San Jose permit H18-057 (Site Permit, folder year 2018), status Approved, issue date 2019-01-30: \"Site Development Permit to allow construction of an eight story affordable housing structure with approximately 87 units and an alternative parking arrangement (i.e. carlifts), to allow three concessions and two waivers (Balbach and Almaden building setba\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC CA-20-615 (Sept. 16, 2020): $2,453,657 annual federal credits recommended, no state credits; 87 units, 86 restricted; bond issuer City of San Jose; total project cost at application $60,531,369. In that application Silicon Valley Bank was the construction lender.",
      "src": [
        "SRC-003102"
      ]
    },
    {
      "text": "SAHA groundbreaking release: the City provided the land (a former city parking lot) and more than $15 million; Chase is the tax-exempt construction bond and permanent lender; the AHSC grant funds two electric VTA buses, transit passes and bikeshare memberships.",
      "src": [
        "SRC-003101"
      ]
    },
    {
      "text": "State report 2021 permit row lists 19 extremely low-income units within the 56 very low-income units, and other funding: Chase tax-exempt bond, City of San Jose loan, land donation, deferred developer fees, IIG, AHSC.",
      "src": [
        "SRC-001107"
      ]
    },
    {
      "text": "SAHA lists the address as 500 South Almaden Boulevard, formerly 226 Balbach Street.",
      "src": [
        "SRC-003100"
      ]
    }
