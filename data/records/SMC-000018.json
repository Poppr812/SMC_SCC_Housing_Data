    "affordability_notes": {
      "claims": [
        {
          "value": "Up to 200 affordable units in a stand-alone building on the northern portion of the site",
          "src": [
            "SRC-000403"
          ]
        },
        {
          "value": "About 268 affordable homes, exceeding the city's 15 percent affordability requirement",
          "src": [
            "SRC-000402"
          ]
        },
        {
          "value": "Development agreement: Alexandria to transfer a parcel of at least 2.01 acres (Vesting Tentative Map Parcel 2) to a qualified affordable housing developer for at least 153 affordable units, satisfying the requirement for the first 861 market-rate units (first 1,014 units). Staff report: the site could yield 200 units; at 1,514 total units, 268 affordable (17.7%). MidPen Housing named as partner.",
          "src": [
            "SRC-002136"
          ]
        },
        {
          "value": "City Council presentation, Nov. 17, 2026: 1,000 required multi-family units with at least 15% affordable; about 150-200 affordable units in a stand-alone MidPen Housing project",
          "src": [
            "SRC-004282"
          ],
          "note": ""
        }
      ],
      "question": "How many affordable units does the Tanforan project include: up to 200 or about 268?"
    },
