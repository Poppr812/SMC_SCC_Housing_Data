  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "CTCAC CA-23-430: The project, 80 Saratoga Avenue Apartments, located at 80 Saratoga Avenue in Santa Clara, requested and is being recommended for a reservation of $6,782,702 in annual federal tax credits and $32,860,000 in total state tax credits to finance the new construction of 198 units of housing serving families with rents affordable to households earning 30%-80% of area median income (AMI). Recorded as a note because this funding covers 80 Saratoga Avenue Apartments (200 units), which may be one component of this record.",
      "src": [
        "SRC-001632"
      ]
    },
    {
      "text": "The project now operates under the 88 Saratoga Avenue address. The city bulletin counts 198 affordable rental apartments. No source read gives a completion date.",
      "src": [
        "SRC-001929"
      ]
    },
    {
      "text": "CTCAC CA-23-430 (May 10, 2023): applicant Central Valley Coalition for Affordable Housing; general partners Central Valley Coalition for Affordable Housing, TPC Holdings IX, LLC and Santa Clara-Saratoga, LLC; parent companies Central Valley Coalition, The Pacific Companies and Maracor Development; 200 units, 198 low-income; recommended $6,782,702 annual federal and $32,860,000 state credits; total project cost $148,568,639 ($705,343 per unit), attributed to Bay Area construction costs, podium parking and impact and permitting fees; management agent ConAm.",
      "src": [
        "SRC-001632"
      ]
    },
    {
      "text": "TEFRA staff report, September 2023: Santa Clara Pacific Associates, a California limited partnership, asked CMFA to issue up to $95,000,000 in exempt facility bonds for the 200-unit project; developer Pacific West Communities, Inc.",
      "src": [
        "SRC-002662"
      ]
    },
    {
      "text": "Parkland agreement, February 2025: requirement of 1.0608 acres met by 0.8077 acres of private recreational amenities (credit of $2,067,629) and $4,639,551 in parkland in-lieu fees.",
      "src": [
        "SRC-002663"
      ]
    },
    {
      "text": "San José Spotlight, July 2023: 200 apartments on a nearly two-acre former YMCA site, six stories with five levels of apartments over one parking level, about 8,600 sq ft of commercial space; Maracor Development named as developer. SF YIMBY, April 2021: 209 units proposed with YMCA of Silicon Valley as applicant, 90 structured and 15 surface parking spaces.",
      "src": [
        "SRC-002659",
        "SRC-002661"
      ]
    }
  ],
