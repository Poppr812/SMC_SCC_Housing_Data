  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001134",
        "SRC-001143"
      ]
    },
    {
      "text": "The 60-unit building is an addition to The Franciscan, a 180-unit garden apartment community built in 1971 (16 two-story and 2 one-story buildings, 90 one-bedroom and 90 two-bedroom units, 7.5 gross acres). It replaces the leasing office, fitness facility, laundry room, pool and spa; no existing apartments are removed.",
      "src": [
        "SRC-003392",
        "SRC-003394"
      ]
    },
    {
      "text": "Planning submittal: 263 parking spaces proposed for the combined existing and new buildings, 73 of them in a subterranean garage; 178 required under density bonus standards. Construction planned in one phase over 18 to 24 months.",
      "src": [
        "SRC-003392"
      ]
    },
    {
      "text": "Raintree Partners lists the 60 units as entitled, with a new 1,500 SF clubhouse and pool deck.",
      "src": [
        "SRC-003394"
      ]
    }
