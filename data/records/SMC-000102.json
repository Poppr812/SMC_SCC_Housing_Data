  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001104",
        "SRC-001105"
      ]
    },
    {
      "text": "City list gives APN 005-330-320 and others. That APN is not in the current county parcel layer; this record is on 005-330-020.",
      "src": [
        "SRC-001158"
      ]
    },
    {
      "text": "CTCAC CA-24-471: Midway Village Phase 2, located at 47 Midway Drive in Daly City on a 1.79 acre site, requested and is being recommended for a reservation of $6,418,635 in annual federal tax credits and $65,352,000 of tax-exempt bond cap to finance the new construction of 113 units of housing, consisting of 111 restricted rental units, and 2 unrestricted manager's units. Recorded as a note because this funding covers Midway Village Phase 2 (113 units), which may be one component of this record.",
      "src": [
        "SRC-001650"
      ]
    },
    {
      "text": "San Mateo County AHF predevelopment pipeline, September 2024: Midway Village II (Midpen Housing): 128 total units, 20% at 15-30% AMI and 47% at 31-60% AMI.",
      "src": [
        "SRC-001649"
      ]
    },
    {
      "text": "MidPen: master plan in four phases replacing 150 Housing Authority units with 555 apartments. Phase 2 (113 units) is tracked separately as SMC-000035.",
      "src": [
        "SRC-000634",
        "SRC-002205"
      ]
    },
    {
      "text": "Phase 1 (MidPen profile): 147 units at 80 and 88 Park Street, two four-story buildings, 3.45 acres, 190 parking spaces; 29 studios, 24 one-bedroom, 56 two-bedroom, 30 three-bedroom, 8 four-bedroom; families up to 80% AMI and transition-aged youth. Construction started fall 2021, complete December 2023.",
      "src": [
        "SRC-002205"
      ]
    },
    {
      "text": "CTCAC CA-20-668 (December 9, 2020): Midway Village Phase 1, 45 & 47 Midway Drive, 147 units (145 low-income) at 30-80% AMI (15 at 30%, 64 at 50%, 27 at 60%, 39 at 80%); $4,853,512 annual federal credits; HUD Section 8 project-based vouchers on 60 units; bond issuer California Municipal Finance Authority; total project cost at application $120,621,024. Sources listed include Bank of America tax-exempt and taxable loans, San Mateo County AHF 6.0 and 8.0, HACSM funds, deferred developer fee and tax credit equity.",
      "src": [
        "SRC-002206"
      ]
    },
    {
      "text": "MidPen May 2025 release lists Phase 1 and Phase 2 funders: San Mateo County Department of Housing, Housing Authority of the County of San Mateo, Wells Fargo, Freddie Mac, CDLAC, California Municipal Finance Authority and CTCAC.",
      "src": [
        "SRC-000634"
      ]
    }
  ],
