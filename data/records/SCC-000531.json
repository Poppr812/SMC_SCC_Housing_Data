  "construction_notes": [
    {
      "text": "City is the site owner.",
      "src": [
        "SRC-001484"
      ]
    },
    {
      "text": "February 2026 staff report: four proposals were presented. Current Proposal A had six stories and 122 units with 65 stalls and a $20,325,000 anticipated city funding request; Proposal C (five stories, three along Charles Street, 110 units including 24 studios, 65 stalls) carried a $19,425,000 anticipated city funding request. Council directed negotiation on Proposal C, with a DDA and long-term ground lease expected within six to 12 months.",
      "src": [
        "SRC-002986"
      ]
    },
    {
      "text": "Site was a gasoline service station in the 1950s to 1970s; two potential underground storage tanks were noted by radar but not confirmed, and consultants recommend at-grade construction with a vapor barrier.",
      "src": [
        "SRC-002986",
        "SRC-002987"
      ]
    },
    {
      "text": "Application letter: 1.039-acre site with a vacant 10,038 sq ft former Wells Fargo bank building; heights up to 66'-4\" on Mathilda and 38'-6\" on parts of Charles Street; about 0.3 mile from Sunnyvale Caltrain.",
      "src": [
        "SRC-002984"
      ]
    }
