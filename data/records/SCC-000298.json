  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106"
      ]
    },
    {
      "text": "Replaces the 160-unit apartment building (16 moderate-income units) entitled with Agrihood in 2019 under BLD2019-57058.",
      "src": [
        "SRC-001102",
        "SRC-001972"
      ]
    },
    {
      "text": "Staff report: the 44 townhomes replace 160 entitled mixed-income apartments (16 moderate-income) on this part of the Agrihood site. Site-wide totals go from 361 to 245 units and from 181 to 171 affordable units. Built so far: 165 affordable senior and veteran apartments and 36 market-rate townhomes. Staff recommended denial to both the Planning Commission and the Council.",
      "src": [
        "SRC-001544",
        "SRC-003531"
      ]
    },
    {
      "text": "Five three-story buildings (one 12-unit, four 8-unit). Staff report gives a 45-foot maximum height; SF YIMBY reports about 41 feet. Density bonus waivers requested: height from 40 ft to 41 ft 6 in, front setback from 10 ft to 5 ft, rear setback from 15 ft to 8 ft.",
      "src": [
        "SRC-001544",
        "SRC-001545"
      ]
    }
