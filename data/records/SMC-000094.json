  "construction_notes": [
    {
      "text": "Approval extended to June 19, 2028; city issued a vacant-lot notice on December 19, 2023",
      "src": [
        "SRC-001078"
      ]
    },
    {
      "text": "County parcel layer: all 11 parcels on the block (034-185-030, -040, -050, -110, -120, -140, -150, -160, -170, -190, -200) are owned by WHPV Block 21 Owner LLC; the 2026 CEQA notice lists the same 11 APNs.",
      "src": [
        "SRC-001103",
        "SRC-002945"
      ]
    },
    {
      "text": "2026 Notice of Exemption: extension of the Tentative Map, SPAR and SDPA approvals to June 18, 2028; scope unchanged (six stories, 111 for-rent units with 12 very low-income, 179,560 sq ft office). The city page gives June 19, 2028.",
      "src": [
        "SRC-002945"
      ]
    },
    {
      "text": "2022 MND: six-story, 268,938 sq ft mixed-use building with two below-grade parking levels; demolishes about 32,871 sq ft of buildings including a gas station at 3rd Ave and S Delaware St; zoning CBD/S. State report notes 8 existing units demolished, net 103 new units.",
      "src": [
        "SRC-002944",
        "SRC-001108"
      ]
    },
    {
      "text": "Housing Action Coalition endorsement (May 2022) lists 68 homes, 15% below-market-rate, at 300 S Delaware St; the MND from the same month lists 111 units.",
      "src": [
        "SRC-002946",
        "SRC-002944"
      ]
    }
