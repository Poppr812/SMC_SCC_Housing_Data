  "construction_notes": [
    {
      "text": "55 townhome condominiums plus 10 ADUs.",
      "src": [
        "SRC-001464"
      ]
    },
    {
      "text": "The site holds one 35,170 square foot multi-tenant commercial building with the United Furniture store and vacant spaces. It was named a Priority Housing Site in the 2024 Housing Element and rezoned in July 2024.",
      "src": [
        "SRC-003452"
      ]
    },
    {
      "text": "The staff report lists APNs 369-06-002, -003 and -004 and the location as 10075 E. Estates and 19610 Stevens Creek Blvd. Density bonus waivers were requested for setbacks, common open space and lot coverage, and a concession for the mixed-use requirement.",
      "src": [
        "SRC-003452"
      ]
    },
    {
      "text": "San José Spotlight reports the 2024 Housing Element assumed 163 homes on this site, 93 of them moderate-income, and that the approval started a 180-day no-net-loss period on December 16.",
      "src": [
        "SRC-003453"
      ]
    }
