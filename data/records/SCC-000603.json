  "construction_notes": [
    {
      "text": "City APNs: 120-16-038 (332 Forest) and 120-16-070 (350 Forest; county situs 360 Forest). YIMBY's 69-unit article cites 350 Forest but its images are labeled 332 Forest, and it describes one 0.6-acre property.",
      "src": [
        "SRC-001895",
        "SRC-001896"
      ]
    },
    {
      "text": "Two parallel applications: a planned home zoning (PHZ) version (city page and June 2026 plans: 8 stories, 82 units, 85 ft plus parapet; Palo Alto Online: 89 units) and an SB 79 version (69 units, 65 ft, 98 parking spaces, 76 bike spaces, nine affordable units). Palo Alto Online reports the SB 79 version as six stories.",
      "src": [
        "SRC-003314",
        "SRC-003316",
        "SRC-003317"
      ]
    },
    {
      "text": "Existing two-story, 16-unit, 12,000 sq ft apartment building to be demolished. PHZ version: Type IA/IIIA, wood frame over a three-story concrete podium with one level below grade; community room opens onto the grounds of Casa Real.",
      "src": [
        "SRC-003314"
      ]
    }
  ],
