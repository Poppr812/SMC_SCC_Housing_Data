  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001126"
      ]
    },
    {
      "text": "State notice lists seven parcels to be merged: APNs 137-08-016, 137-08-070, 137-08-077, 137-08-079, 137-08-080, 137-08-081, 137-08-088. Vesting map file 25PLN-00243. The record carries only 137-08-080.",
      "src": [
        "SRC-001280",
        "SRC-001279"
      ]
    },
    {
      "text": "Daily Post: seven stories, 83 feet; 163 studios and one-bedrooms and 158 two- and three-bedrooms; replaces 38 apartments, a smog check station and a vacant lot; garage exits on Matadero and Kendall avenues. The Planning and Transportation Commission and the Barron Park Association opposed the project over road safety.",
      "src": [
        "SRC-002351"
      ]
    },
    {
      "text": "City page: Vesting Tentative Map 25PLN-00243 merges seven parcels into one 113,907 sq ft parcel; zoning CN, CS, RM-30 and RM-40; two levels of above-ground parking, ground-floor amenities and a rooftop terrace.",
      "src": [
        "SRC-001279"
      ]
    },
    {
      "text": "San Jose Spotlight credits the 321-unit approval to Vittoria and reports the council vote as unanimous.",
      "src": [
        "SRC-002352"
      ]
    }
