  "construction_notes": [
    {
      "text": "City lists a fourth APN, 063-221-090, which is not in the county parcel layer.",
      "src": [
        "SRC-001178"
      ]
    },
    {
      "text": "City describes it as \"4-story corporate housing with 136 Single Room Occupancy (SRO) units\"; no affordability stated.",
      "src": [
        "SRC-001178"
      ]
    },
    {
      "text": "City page describes 28,000 sq ft, 4-story corporate housing with 136 SRO units; the December 2025 meeting flyer describes 135 SRO units. Plans show a typical unit of 133 sq ft, a separate 4,298 sq ft leasing and amenity building (leasing office, mail room, gym, shared offices, kitchen), a pool, Type V-A construction and a 50-foot height. Existing buildings, including a former post office, would be demolished.",
      "src": [
        "SRC-001178",
        "SRC-002798",
        "SRC-002799"
      ]
    },
    {
      "text": "Plan set lists the owner as Clarum Four Corners, LLC at 777 North 1st Street, San Jose, with a swenson.com contact; architectural sheets are by Swenson. The flyer names Mark Pilarczyk, President of Development, as project contact.",
      "src": [
        "SRC-002799",
        "SRC-002798"
      ]
    },
    {
      "text": "City page lists APNs 063-221-010, -020, -030 and -090; the plan set lists 063-221-010, -020, -030 and -490. County parcel layer shows 063-221-490 with Clarum Four Corners LLC among owners and has no record for 063-221-090.",
      "src": [
        "SRC-001178",
        "SRC-002799",
        "SRC-001103"
      ]
    }
