  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001101",
        "SRC-001110"
      ]
    },
    {
      "text": "CTCAC CA-22-504: La Avenida Apartments, located at 1100 La Avenida Street in Mountain View, requested and is being recommended for a reservation of $3,026,092 in annual federal tax credits to finance the new construction of 98 units of housing serving tenants with rents affordable to households earning 30%-60% of area median income (AMI).",
      "src": [
        "SRC-001622"
      ]
    },
    {
      "text": "Mountain View Voice (June 2025) reports $19 million in county Measure A funding and $16 million from the City of Mountain View; the CTCAC staff report lists $6,473,777 from Santa Clara County and $15,000,000 from the City.",
      "src": [
        "SRC-003151",
        "SRC-001622"
      ]
    },
    {
      "text": "David Baker Architects lists 107,176 sq ft of project area on a 41,768 sq ft site, 104 units per acre, Type I and Type V construction.",
      "src": [
        "SRC-003152"
      ]
    },
    {
      "text": "Eden Housing's groundbreaking release lists funders: City of Mountain View, County of Santa Clara, Santa Clara County Housing Authority, CTCAC, CDLAC, California Municipal Finance Authority, Wells Fargo, California Community Reinvestment Corporation, Housing Trust of Silicon Valley, California Energy Commission and The Home Depot Foundation.",
      "src": [
        "SRC-003156"
      ]
    },
    {
      "text": "County parcel data gives the situs for APN 116-14-137 as 1110 La Avenida St; Eden Housing and news use 1188 Armand Drive; state and CTCAC filings use 1100 La Avenida.",
      "src": [
        "SRC-001098",
        "SRC-003155"
      ]
    }
  ],
