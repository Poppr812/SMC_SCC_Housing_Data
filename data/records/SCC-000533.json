  "construction_notes": [
    {
      "text": "City item describes 101 market-rate townhouse units and a 23,104 sq ft commercial building. Planning Commission continued it on October 27, 2025 to November 24, 2025; outcome not found in the items read.",
      "src": [
        "SRC-001487"
      ]
    },
    {
      "text": "Sunnyvale file 25-0575 (May 2025 Planning Commission) described demolition of the Lakewood Shopping Center and a former auto service center, 101 townhomes in 15 three-story buildings, a one-story 10,000 sq ft commercial building, and a vesting tentative map for 27 lots and 101 condominiums; zoning C-1/PD.",
      "src": [
        "SRC-003149"
      ]
    },
    {
      "text": "Sunnyvale file 25-0975 (October 2025) describes a two-story 23,104 sq ft commercial building and 101 market-rate townhouses in 15 three-story buildings, a vesting tentative map for 26 lots and 101 condominium spaces, and zoning VCMU-22 and VCC. The Planning Commission continued the hearing to a date uncertain on 2025-10-27.",
      "src": [
        "SRC-001487",
        "SRC-001749"
      ]
    },
    {
      "text": "San Jose Spotlight (May 2025) reports the center includes New Wing Yuan Market and that Kelley Rutchena is director of entitlements for True Life's Bay Area branch.",
      "src": [
        "SRC-003150"
      ]
    }
  ],
