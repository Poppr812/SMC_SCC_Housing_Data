  "construction_notes": [
    {
      "text": "CTCAC CA-26-011: The project, 1510 North First, located at 1510 North First Street in San Jose, requested and is being recommended for a reservation of $1,696,412 in annual federal tax credits to finance the adaptive reuse of 57 units of housing serving special needs tenants with rents affordable to households earning 30% of area median income (AMI).",
      "src": [
        "SRC-001609"
      ]
    },
    {
      "text": "CTCAC: adaptive reuse of an existing 58-room Comfort Suites hotel into 57 LIHTC units and 1 manager's unit, one residential building. 57 units receive HUD Section 8 project-based vouchers / Moving to Work. 2025 targeted rent $1,055 for studios at 30% AMI. Rehabilitation costs $10,832,562; land and acquisition $10,600,200; per-unit cost $543,898.",
      "src": [
        "SRC-001609"
      ]
    },
    {
      "text": "CTCAC construction-period sources: JP Morgan Chase $12,394,224; SCCHA MTW $9,517,984; City of San Jose $5,700,000; accrued interest $494,161; deferred costs $2,162,015; tax credit equity $1,277,693.",
      "src": [
        "SRC-001609"
      ]
    }
  ],
