  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001141",
        "SRC-001142"
      ]
    },
    {
      "text": "San Francisco YIMBY (May 2026) on 951 Old County Road: 63 units, eight stories, CRP Affordable Housing and Community Development; City of Belmont approved an additional $2 million. County parcel data shows 951 Old County Rd on a separate parcel, 040-313-430.",
      "src": [
        "SRC-001258"
      ]
    },
    {
      "text": "CTCAC CA-25-689: The Ridge at Ralston, located at 678 Ralston Avenue in Belmont on a 0.36 acre site, requested and is being recommended for a reservation of $2,597,613 in annual federal tax credits, $6,000,000 in total state tax credits, and $16,000,000 of tax-exempt bond cap to finance the new construction of 65 units of housing, consisting of 64 restricted rental units and 1 unrestricted manager's unit. Recorded as a note because this funding covers The Ridge at Ralston (65 units), which may be one component of this record.",
      "src": [
        "SRC-001667"
      ]
    },
    {
      "text": "CTCAC application CA-26-546, The Ridge on Masonic: 63 total units, 62 low-income, 951 Old County Road, APN 040-313-430. Application, not an award: bond request $15,800,000, federal credit request $2,477,079 (CDLAC May 19, 2026 applicant list).",
      "src": [
        "SRC-001668"
      ]
    },
    {
      "text": "San Mateo County AHF predevelopment pipeline, September 2024: Ridge at Ralston (Abode/CRP Dev.): 64 total units, 26% at 15-30% AMI, 55% at 31-60%, 19% at 61-80%.",
      "src": [
        "SRC-001649"
      ]
    },
    {
      "text": "Split: The Ridge on Masonic (951 Old County Rd, APN 040-313-430) now has its own record. The 951 Old County address and combined state rows remain on this record.",
      "src": [
        "SRC-001667"
      ]
    },
    {
      "text": "County FONSI notice (2023-12-15): average unit sizes 560 sq ft (one-bedroom), 694 sq ft (two-bedroom) and 982 sq ft (three-bedroom); 100% affordable for 55 years; replaces an existing dry-cleaning business at APN 040-313-280.",
      "src": [
        "SRC-003359"
      ]
    },
    {
      "text": "951 Old County Road, Belmont, is reported by SF YIMBY and AO as a separate 63-unit, eight-story affordable project (The Ridge On Masonic) by CRP Affordable Housing and Community Development on a 0.35-acre lot, with 21 one-, 21 two- and 21 three-bedroom units and a $2 million additional City of Belmont loan reported in May 2026.",
      "src": [
        "SRC-001755",
        "SRC-001913"
      ]
    }
