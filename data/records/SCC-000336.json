  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001134",
        "SRC-001143"
      ]
    },
    {
      "text": "City describes 25 townhomes and one apartment building with up to 10 units. The index count of 25 covers the townhomes.",
      "src": [
        "SRC-001551"
      ]
    },
    {
      "text": "CEQA Notice of Determination describes 25 townhomes, 12 of them with junior ADUs, a 10-unit apartment building, and a subdivision creating 33 lots. Addresses listed: 60 Dillon Ave and 57, 63, 71, 85 and 101 Gilman Ave.",
      "src": [
        "SRC-003807"
      ]
    },
    {
      "text": "San José Spotlight (2024-05-13) reports the City Council approved the project unanimously in May 2024 with 25 townhomes, 10 apartments and 12 junior ADUs; two houses on Gilman Avenue and several businesses on Gilman and Dillon avenues would be demolished.",
      "src": [
        "SRC-003805"
      ]
    },
    {
      "text": "Robson Homes markets the townhomes as Parklane, marked Now Selling, with the sales office at 127 Gilman Ave. Fee-simple, all-electric three-story townhomes in four plans of 1,403 to 2,410 sq ft, 2 to 4 bedrooms; two plans include a first-floor junior ADU. Site plan shows lots 2 through 26.",
      "src": [
        "SRC-003806"
      ]
    }
