  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-23-548 Meridian Family Apartments: 233 total units, 231 low-income units; stage Preliminary Reservation; developer ROEM Development Corporation; annual federal credit 8218606; total state credit 24841586.",
      "src": [
        "SRC-001603"
      ]
    },
    {
      "text": "CalHFA final commitment (Senior Loan Committee 2024-03-06, Board 2024-03-21): one six-story building (five stories over podium) with 1,795 sq ft retail; 67 one-bedroom (585 sq ft), 90 two-bedroom (832 sq ft) and 76 three-bedroom (1,006 sq ft) units; 231 restricted between 30% and 70% AMI; two manager units.",
      "src": [
        "SRC-002529"
      ]
    },
    {
      "text": "73 units supported by HUD Project-Based Vouchers: 35 HUD-VASH units for chronically homeless veterans and 38 for large families.",
      "src": [
        "SRC-002529"
      ]
    },
    {
      "text": "Land purchase $15,700,000; City of San Jose permit and impact fees $8,388,000. Tax credit investor changed from R4 Capital LLC to Hudson Housing Capital.",
      "src": [
        "SRC-002529"
      ]
    },
    {
      "text": "2021 report gave an estimated cost of $90.6 million, with about $23 million in Section 8 Project-Based Vouchers over 20 years.",
      "src": [
        "SRC-002531"
      ]
    }
  ],
