  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "Article states 120 apartments but its income breakdown sums to 150 including the manager unit. Not reconciled.",
      "src": [
        "SRC-001541"
      ]
    },
    {
      "text": "CTCAC CA-25-760: Clara Gardens, located at 3550 El Camino Real in Santa Clara on a 1.12 acre site, requested and is being recommended for a reservation of $5,147,401 in annual federal tax credits and $31,564,205 of tax-exempt bond cap to finance the new construction & adaptive reuse of 120 units of housing, consisting of 119 restricted rental units and 1 unrestricted manager's unit.",
      "src": [
        "SRC-001671"
      ]
    },
    {
      "text": "43 renovated units in the existing two-story motel and 77 new units in a seven-story building; 25% of units set aside for formerly homeless households.",
      "src": [
        "SRC-002898",
        "SRC-002895"
      ]
    },
    {
      "text": "Architect project sheet lists 1,200 sq ft ground-floor commercial space, two community rooms, a third-floor roof deck and three-level parking stackers.",
      "src": [
        "SRC-002895"
      ]
    },
    {
      "text": "2022 project data: existing two-story motel with 63 parking spaces; proposed seven stories (72 ft) and 81 spaces; zoning changed from CT to VHDMU.",
      "src": [
        "SRC-002893"
      ]
    },
    {
      "text": "May 2026 article: city staff said a building permit had been issued; CMFA said the bond would likely be close to $31 million; RCD said the county owns the land and interim residents moved out at the end of March 2026.",
      "src": [
        "SRC-002894"
      ]
    }
  ],
