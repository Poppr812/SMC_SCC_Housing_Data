  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-22-618: Alum Rock Multifamily, located at 1860 Alum Rock Avenue in San Jose, requested and is being recommended for a reservation of $2,773,549 in annual federal tax credits and $851,925 in total state tax credits to finance the new construction of 59 units of housing serving special needs and large family tenants with rents affordable to households earning 30%-50% of area median income (AMI).",
      "src": [
        "SRC-001630"
      ]
    },
    {
      "text": "City of San Jose permit CP20-017 (Ministerial Permit, folder year 2020), status Approved, issue date 2021-09-09: \"SB 35 Streamlined Ministerial Permit to demolish two commercial structures of 5,760 square feet and construct a 5-story 100% affordable housing development with 60 units and 3,190 square feet of commercial space, with a State Density Bonus Request for thr\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Housing Trust Silicon Valley states the County of Santa Clara funded the project through the 2016 Measure A Housing Bond, and names the City of San Jose, Santa Clara County Housing Authority, Destination: Home and Amigos de Guadalupe as partners. Charities Housing lists the property as 1860 Alum Rock Apartments.",
      "src": [
        "SRC-003355",
        "SRC-003356"
      ]
    }
