  "construction_notes": [
    {
      "text": "CTCAC CA-21-576: Kiku Crossing, located at 480 East 4th Avenue and 400 East 5th Avenue in San Mateo, requested and is being recommended for a reservation of $7,431,357 in annual federal tax credits to finance the new construction of 223 units of housing serving large families with rents affordable to households earning 30- 80% of area median income (AMI).",
      "src": [
        "SRC-001604"
      ]
    },
    {
      "text": "City contributed the land under a long-term ground lease plus $12.5 million toward construction; the city release put the anticipated development cost at $170 million.",
      "src": [
        "SRC-002582"
      ]
    },
    {
      "text": "Unit allocation per the county: 22 units for formerly homeless households, 8 for people with intellectual and developmental disabilities, 57 for public employees. County Measure K funds of more than $5 million.",
      "src": [
        "SRC-002588"
      ]
    },
    {
      "text": "Unit sizes per MidPen: studio 380 sf, 1BR 529 sf, 2BR 784 sf, 3BR 1,029 sf. Construction type Type IIIA over Type IA; garage Type IA.",
      "src": [
        "SRC-002584"
      ]
    },
    {
      "text": "MidPen calls Kiku Crossing the largest single-phase development in its history.",
      "src": [
        "SRC-002586"
      ]
    }
  ],
