  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001124",
        "SRC-001128"
      ]
    },
    {
      "text": "The project adds 44 units in six residential buildings within the existing Sunnyhills Apartments (171 units in 45 one- to two-story buildings on 12.66 acres), replacing the leasing/community building with a new 1,791 sq ft leasing building. The IS/MND gives the complex APN as 026-06-009; the state report lists 2606009.",
      "src": [
        "SRC-003528",
        "SRC-001128"
      ]
    },
    {
      "text": "The city's letter to residents says 149 units in the existing complex carry a HUD contract and that the owner moved forward with 44 new units (37 market rate, 7 affordable). GoMilpitas reports JMK Investments renewed the HUD contract through 2028.",
      "src": [
        "SRC-003529",
        "SRC-003530"
      ]
    }
