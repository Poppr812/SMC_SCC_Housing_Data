  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001101",
        "SRC-001110"
      ]
    },
    {
      "text": "84 affordable units and one manager's unit in two five-story buildings.",
      "src": [
        "SRC-001327"
      ]
    },
    {
      "text": "CTCAC CA-23-534: Montecito Multifamily, located at 1265 Montecito Avenue in Mountain View, requested and is being recommended for a reservation of $3,909,764 in annual federal tax credits to finance the new construction of 84 units of housing serving families with rents affordable to households earning 30%-50% of area median income (AMI).",
      "src": [
        "SRC-001639"
      ]
    },
    {
      "text": "Developer page: unit sizes are studios 339-411 sq ft, one-bedrooms 512-517, two-bedrooms 668-824 and three-bedrooms 973-1,092; 50% of units are reserved for Rapid Rehousing households in partnership with the County Office of Supportive Housing.",
      "src": [
        "SRC-003117"
      ]
    },
    {
      "text": "Mountain View Voice (Feb 22, 2024): replaces a vacant office building; Santa Clara County provided $18 million plus project-based vouchers; residents expected to move in early 2026.",
      "src": [
        "SRC-003118"
      ]
    },
    {
      "text": "Mountain View Legistar also lists a 2021 agreement with Rincon Consultants for environmental review and a 2023 item on tax-exempt bond financing for 1265 Montecito Avenue.",
      "src": [
        "SRC-003122"
      ]
    }
  ],
