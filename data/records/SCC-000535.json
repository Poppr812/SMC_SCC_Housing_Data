  "construction_notes": [
    {
      "text": "Planning Commission approved; appeal status not checked.",
      "src": [
        "SRC-001491"
      ]
    },
    {
      "text": "Plans name the project The Arcade: 28 all-electric, three-story townhome-style condominiums of 1,419 to 1,841 sq ft with 3 to 4 bedrooms, in four buildings.",
      "src": [
        "SRC-003751"
      ]
    },
    {
      "text": "The plan set lists Hunt Hale Jones Architects as architect and Fournier Design Studio as designer; SF YIMBY credits Ascent Architecture with the designs and renderings.",
      "src": [
        "SRC-003751",
        "SRC-001492"
      ]
    },
    {
      "text": "The site holds an office building with a restaurant (Agape Grill) and three commercial spaces that the applicant said had been vacant for a couple of years.",
      "src": [
        "SRC-003750",
        "SRC-001493"
      ]
    },
    {
      "text": "Planning Commission approval added a condition that the CC&Rs disclose the vapor barrier and ongoing monitoring and prohibit basements or other foundation penetrations; the site is near a Superfund site.",
      "src": [
        "SRC-001493"
      ]
    },
    {
      "text": "City Ventures staff at the hearing: Julia Koppman Norton, Senior Development Manager, and Samantha Hauser, Head of Development and Executive Vice President.",
      "src": [
        "SRC-001493"
      ]
    }
