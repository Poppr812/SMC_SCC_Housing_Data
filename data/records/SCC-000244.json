  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-22-633: The Charles, located at 551 Keyes Street in San Jose, requested and is being recommended for a reservation of $4,188,983 in annual federal tax credits and $5,907,677 in total state tax credits to finance the new construction of 97 units of housing serving special needs tenants with rents affordable to households earning 30%-50% of area median income (AMI).",
      "src": [
        "SRC-001631"
      ]
    },
    {
      "text": "City of San Jose permit H21-002 (Site Development Permit/Amendment, folder year 2021), status Approved, issue date 2021-06-01: \"SB 35 Ministerial Permit for the construction of a 100% affordable rental project consisting of a six story building with 78 residential units, 4,398 square feet of related service and office area, 69 parking spaces and the removal of 6 ordinance and 8 no\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "City of San Jose permit HA21-002-01 (Site Development Permit/Amendment, folder year 2021), status Approved, issue date 2021-10-29: \"Site Development Permit Amendment to allow exterior changes including: the addition of a new floor 11,069 SF, the addition of 21 residential units, an increase in common open space by 1,709 SF, a reduction in private open space by 2,183 SF, and an increas\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "CTCAC staff report construction financing table lists Silicon Valley Bank - TE $44,565,052, Silicon Valley Bank - Taxable $5,848,164, City of San Jose $9,267,938, County of Santa Clara Measure A $9,280,000, costs deferred until conversion $2,557,587 and tax credit equity $12,228,182 during construction. Bond issuer: City of San Jose. Census tract 5031.12.",
      "src": [
        "SRC-001631"
      ]
    },
    {
      "text": "SF YIMBY (June 2023), citing Bay Area News Group: $9.3 million from Santa Clara County, $9.3 million from the City of San Jose, $12.2 million in tax credit investment and $44.6 million in tax-exempt bond proceeds; total cost $87 million.",
      "src": [
        "SRC-003034"
      ]
    },
    {
      "text": "Blach groundbreaking release names as partners Santa Clara County, City of San Jose, California Community Reinvestment Corporation, Santa Clara County Housing Authority, Housing Trust Silicon Valley, Wells Fargo, CDLAC and CTCAC, without stating each party's role.",
      "src": [
        "SRC-003030"
      ]
    },
    {
      "text": "Architect page: Type IB construction, GreenPoint Rated Platinum target; Blach: concrete structure, rooftop photovoltaic array, sixth-floor terrace. Named for Dr. Charles Preston (Housing Trust Silicon Valley).",
