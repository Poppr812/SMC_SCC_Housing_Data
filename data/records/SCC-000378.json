  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001135"
      ]
    },
    {
      "text": "56 single-family, 64 duets, 149 condominiums. City lists APNs 728-30-001 to -004; this record's parcel is a later lot in Phase 1.",
      "src": [
        "SRC-001436"
      ]
    },
    {
      "text": "City Council certified the EIR and approved the vesting tentative map and design permit on June 21, 2023 (Resolution 23-032). Three phases; the first phase has 94 homes. Approval includes preserving an equal acreage of farmland elsewhere, transit passes for residents and a contribution to the MoGo rideshare service.",
      "src": [
        "SRC-001436",
        "SRC-002483"
      ]
    },
    {
      "text": "KB Home's Haven at Crosswinds page lists 1260 Pueblo Ln (this record's main address): three-story townhome-style condos, 2 to 4 bedrooms, about 1,396 to 2,004 sq ft, base price from $789,000. KB Home's January 23, 2026 release priced Haven from the mid $800,000s, at Mission View Drive and Half Road.",
      "src": [
        "SRC-002485",
        "SRC-002486"
      ]
    }
