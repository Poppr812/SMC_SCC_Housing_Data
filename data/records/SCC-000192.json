  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "City loan report (November 2023) lists planned sources at permanent: tax credit equity $43,111,764, state AHSC $21,600,000, County Measure A $12,100,000, bonds $10,149,000, deferred developer fee $7,500,000, City $5,400,000, Housing Trust Silicon Valley Apple funds $4,750,000. It states Charities Housing planned to apply for AHSC in March 2024 and state tax credits and bonds in September 2024, and to seek 27 project-based vouchers from the Santa Clara County Housing Authority.",
      "src": [
        "SRC-001735"
      ]
    },
    {
      "text": "Architectural review: five-story building with podium parking wrapped by units, studios to three-bedrooms of 379 to 1,139 sq ft, 54 ft 6 in to top of parapet; replaces a vacant 28,950 sq ft two-story office building.",
      "src": [
        "SRC-001736"
      ]
    },
    {
      "text": "City Council approved the project 6-1 in November 2022; Charities Housing bought the site in 2020.",
      "src": [
        "SRC-003002"
      ]
    },
    {
      "text": "Charities Housing's development pipeline page lists Civic Center, Santa Clara, under Predevelopment. SV@Home's Measure A dashboard lists Civic Center Multifamily as Pipeline. HCD AHSC Round 8 and Round 9 award lists show no award for this project.",
      "src": [
        "SRC-002238",
        "SRC-001614",
        "SRC-003003",
        "SRC-003004"
      ]
    }
