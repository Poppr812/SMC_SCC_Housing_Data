  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "Phase of the 913-unit Julian & Tripp plan: 235 affordable units, six stories.",
      "src": [
        "SRC-001816"
      ]
    },
    {
      "text": "City of San Jose permit H21-050 (Site Development Permit/Amendment, folder year 2021), status Approved, issue date 2023-11-29: \"Site Development Permit to allow the demolition of four residential buildings (a 12-unit multifamily residential building, a 28-unit multifamily residential building, and two single-family residences) totaling 42 units, the removal of 10 trees (two ordina\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "IS/MND describes one six-story apartment building of 235 units (studio, one- and two-bedroom), 100 percent affordable, about 73 feet tall, on four parcels at 1298 Tripp Ave, 380 N 26th St and 341 and 345 Wooster Ave; demolishes two apartment buildings and two single-family homes. Requests parking reduction of up to 71 percent (0.25 stalls per unit).",
      "src": [
        "SRC-002527"
      ]
    },
    {
      "text": "The same IS/MND covers Vila de Camila (1325 E. Julian St, 633 units, H22-012) and Casa Inclusiva (1347 E. Julian St, 45 units, H22-001); 913 units in total.",
      "src": [
        "SRC-002527",
        "SRC-002528"
      ]
    },
    {
      "text": "City preliminary review PRE19-106 (2019) described 304 units on two parcels of about 1.25 acres with a 90-stall garage off Tripp Avenue.",
      "src": [
        "SRC-001956"
      ]
    }
