  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001144",
        "SRC-001145"
      ]
    },
    {
      "text": "Earlier design: SF YIMBY (2022-09-16) describes a five-story, 28-unit building with six affordable units, about 47,587 sq ft, two underground parking levels, designed by SDG Architects; the developer was raising a $1.5 million preferred equity round for construction financing.",
      "src": [
        "SRC-003141"
      ]
    },
    {
      "text": "CEQAnet NOE (2025-11-10): eight-story, 109-foot-9-inch building on a 0.43-acre vacant lot at El Camino Real and Jordan Avenue; underground automated parking garage with 95 spaces; rooftop deck; 85 units including 10 very low-income units. The 2025-11-20 NOE says the map merges two parcels into one with 85 condominium lots and one common lot.",
      "src": [
        "SRC-003139",
        "SRC-003142"
      ]
    },
    {
      "text": "Developer investor-update page lists successive concepts: 28-unit condos (approved), 105/99/95-unit senior housing (2024), 105-unit affordable (2024), and the 85-unit, 8-story design (2025). It states the property was listed for sale in 2024 and the first lender agreed to a 4-month loan extension in August 2025.",
      "src": [
        "SRC-003140"
      ]
    }
  ],
