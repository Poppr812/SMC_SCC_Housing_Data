  "construction_notes": [
    {
      "text": "CTCAC CA-26-515 Block 5 Apartments: 65 studio, 48 one-bedroom, 61 two-bedroom and 60 three-bedroom units; 24 units at 30% AMI, 46 at 50%, 68 at 60%, 94 at 70%; total development cost $200,035,551 at application; construction expected November 2026 to March 2029. Construction sources: Chase tax-exempt $53,597,685, Chase taxable $57,423,034, Platinum Valley B residential $48,249,556 and commercial $9,639,667, tax credit equity $7,355,886. Permanent sources: Chase tax-exempt $48,787,800, Platinum Valley B $48,249,556 and $9,639,667, deferred developer fee $14,754,227, GP equity $2,705,446, tax credit equity $75,898,855. Bond issuer California Municipal Finance Authority. CTCAC says the site's parcel and APN are not yet finalized and are part of a larger site.",
      "src": [
        "SRC-001679"
      ]
    },
    {
      "text": "CTCAC CA-26-515: requested and recommended for $9,287,656 in annual federal tax credits and $53,597,685 of tax-exempt bond cap for new construction of 234 units. CTCAC says the site's parcel and APN are not yet finalized and are part of a larger site; the parcel shown is The Rise's.",
      "src": [
        "SRC-001679"
      ]
    },
    {
      "text": "SV@Home, Feb. 2026: the first residential building at The Rise, Town Square West, is 232 affordable homes by Sand Hill Property Company and Eden Housing, half of them two- and three-bedroom units, most at or below 50% AMI; a construction permit application has been submitted.",
      "src": [
        "SRC-001987"
      ]
    }
