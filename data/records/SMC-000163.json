  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001117"
      ]
    },
    {
      "text": "CEQA filings describe a horizontal mixed-use project at 1111-1227 Arguello St on six parcels totaling 3.5 acres (APNs listed as 052-252-080, 052-252-090, 050-252-040, 052-252-030, 052-252-020, 052-252-060): about 300,000 sq ft of office in a four-story building (3.024 acres), a 4,132 sq ft childcare facility, three levels of shared underground parking, and a residential building with 33 affordable units (0.477 acres). The Draft EIR lists a Use Permit among local actions.",
      "src": [
        "SRC-003677",
        "SRC-003678"
      ]
    },
    {
      "text": "Housing Action Coalition endorsed the project on 2021-07-21 as 33 for-sale, 100% affordable homes by Hines and Habitat for Humanity Greater San Francisco. Pickard Chilton's page lists Hines as client, DLR Group as architect of record, a 70-unit affordable housing building, a 30-child day care in preserved historic homes, and a status of proposed, in entitlements.",
      "src": [
        "SRC-003679",
        "SRC-003676"
      ]
    },
    {
      "text": "State report 2023 lists the application (AP2020-057) as pending.",
      "src": [
        "SRC-001117"
      ]
    }
