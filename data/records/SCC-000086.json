  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001106",
        "SRC-001102"
      ]
    },
    {
      "text": "CTCAC CA-26-623: Santa Clara Apartments, located at 4590 Patrick Henry Drive in Santa Clara on a 2.79 acre site, requested and is being recommended for a reservation of $6,263,727 in annual federal tax credits, $24,000,000 in total state tax credits, and $33,500,000 of tax-exempt bond cap to finance the new construction of 271 units of housing, consisting of 268 restricted rental units and 3 unrestricted manager's units.",
      "src": [
        "SRC-001682"
      ]
    },
    {
      "text": "2024 entitlement (PLN23-00290): Walnut Hill Group, represented by KASA Partners; eight-story, 85 ft building with 284 apartments including 42 affordable units, 31 studios, 160 one-bedrooms, 93 two-bedrooms; about 417,450 sq ft (276,000 housing, 126,000 three-story garage); 324 car and 298 bicycle spaces; half-acre public park dedicated to the city. BAR Architects with BKF Engineers; GLS Landscape Architecture.",
      "src": [
        "SRC-002466",
        "SRC-002465"
      ]
    },
    {
      "text": "CEQA filing: demolish a 42,821 sq ft one-story light industrial building; up to 284 units; about 24,370 sq ft of ground-floor public open space; at least 11% of residential developable land dedicated to the City as public parkland per the Patrick Henry Drive Specific Plan.",
      "src": [
        "SRC-002464"
      ]
    },
    {
      "text": "The 2024 entitlement sources name Walnut Hill Group as developer of a 284-unit mixed-income project; the CTCAC CA-26-623 staff report names Meta Development Partners, LLC as developer of a 271-unit, 100% affordable project on the same site.",
      "src": [
        "SRC-002465"
      ]
    }
  ],
