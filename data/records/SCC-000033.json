  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "30-story tower, 540 units. A December 2025 article says of the Westbank and Urban Community projects that only 180 Park Avenue had started.",
      "src": [
        "SRC-001376"
      ]
    },
    {
      "text": "294 feet tall; about 606,520 sq ft total including a 44,360 sq ft garage and about 7,950 sq ft of amenities; room for 58 motorcycles and 176 bicycles. Construction expected to last 33 months.",
      "src": [
        "SRC-001786",
        "SRC-002152"
      ]
    },
    {
      "text": "Demolishes a two-story storage structure and surface parking; the vacant Bo Town restaurant building is preserved.",
      "src": [
        "SRC-002152"
      ]
    },
    {
      "text": "August 2023: developers had submitted for the building permit but had not received it. January 2024: construction had not started; Urban Community expected a start in the first half of 2024.",
      "src": [
        "SRC-002152",
        "SRC-002153"
      ]
    },
    {
      "text": "Targets LEED Platinum, with on-site black water treatment; 312 fruit trees planned along balconies.",
      "src": [
        "SRC-002153"
      ]
    }
  ],
