  "construction_notes": [
    {
      "text": "66 small-lot single-family homes and 56 townhomes.",
      "src": [
        "SRC-001459"
      ]
    },
    {
      "text": "All buildings are three stories; 33 units have fourth-floor access to roof decks. Townhomes are in seven 8-plex buildings. Including garages, townhomes range from 2,273 to 3,304 sq ft and single-family homes are 2,973 or 3,541 sq ft.",
      "src": [
        "SRC-002887"
      ]
    },
    {
      "text": "CEQA notice lists single-family homes at 2,328 to 2,668 sq ft, townhomes at 1,380 to 2,269 sq ft, and about 31,711 sq ft of private open space.",
      "src": [
        "SRC-002888"
      ]
    },
    {
      "text": "Existing site: about 109,000 sq ft of office and 7,000 sq ft of retail (Panera Bread and Voyager Coffee). The project requests 12 density bonus waivers and one concession and pays a $5,880,000 parkland in-lieu fee for the 98 market-rate units.",
      "src": [
        "SRC-002887"
      ]
    },
    {
      "text": "September 2024 filing reported 139 units with 28 affordable on 6.93 acres.",
      "src": [
        "SRC-002890"
      ]
    },
    {
      "text": "State APR 2024 lists the application date as 2024-10-25, status Pending; the city lists the formal application as 2024-09-25.",
      "src": [
        "SRC-001100",
        "SRC-001459"
      ]
    }
