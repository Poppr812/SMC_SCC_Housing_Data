  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001141",
        "SRC-001142"
      ]
    },
    {
      "text": "CTCAC CA-24-103: Hill Street, located at 876, 884, 898, and 900 El Camino Real in Belmont, requested and is being recommended for a reservation of $2,014,263 in annual federal tax credits to finance the new construction of 36 units of housing serving families with rents affordable to households earning 30%-80% of area median income (AMI).",
      "src": [
        "SRC-001648"
      ]
    },
    {
      "text": "San Mateo County AHF predevelopment pipeline, September 2024: Hill Street Apartments (LINC): 36 total units, 61% at 15-30% AMI and 39% at 61-80% AMI.",
      "src": [
        "SRC-001649"
      ]
    },
    {
      "text": "The project is now called The Corners at Belmont. No source read reports completion or leasing as of this check.",
      "src": [
        "SRC-001939",
        "SRC-001940"
      ]
    },
    {
      "text": "The June 2025 announcement names a Bank of America construction loan, with no amount given. The CTCAC plan on this record shows Wells Fargo as construction lender ($22,047,526).",
      "src": [
        "SRC-001939"
      ]
    },
    {
      "text": "Linc Housing release (2025-06-17): the 18 one-bedroom units are for formerly unhoused individuals, each with a Section 8 project-based voucher from the San Mateo County Housing Authority, with referrals from the Health Plan of San Mateo. County funding named: Measure K, ARPA, HOME and CDBG. Bank of America provides the construction loan and is the tax credit investor; California Community Reinvestment Corporation provides the permanent loan.",
      "src": [
        "SRC-003593"
      ]
    },
    {
      "text": "Housing Trust Silicon Valley (2025-04-23): $1,784,500 construction-to-permanent loan through the Apple Affordable Housing Fund.",
      "src": [
        "SRC-003595"
      ]
    }
  ],
