  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-24-069: Hawthorn Senior Apartments, located at 124 N. 15th Street in San Jose, requested and is being recommended for a reservation of $2,127,500 in annual federal tax credits to finance the new construction of 101 units of housing serving seniors with rents affordable to households earning 30%-50% of area median income (AMI).",
      "src": [
        "SRC-001646"
      ]
    },
    {
      "text": "City of San Jose permit MP21-002 (Ministerial Permit, folder year 2021), status Approved, issue date 2022-09-02: \"SB 35 Ministerial Permit to allow the construction of a 103-unit, 100% affordable residential development with a 48-space parking garage and the removal of 15 ordinance-size and 5 non-ordinance-size trees, including a State Density Bonus for three additio\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Leasing flyer: of 101 affordable units, 54 offered by lottery, 21 for County Coordinated Entry referrals, 26 Project-Based Voucher units filled from the housing authority interest list. Income limits at 30% and 50% AMI.",
      "src": [
        "SRC-003015"
      ]
    },
    {
      "text": "San Jose Spotlight (May 2024): total estimated cost about $88.9 million; funding from Measures A and E, federal tax credits, loans, the housing authority and No Place Like Home; about 47 apartments receive federal rental vouchers for at least 20 years.",
      "src": [
        "SRC-003017"
      ]
    },
    {
      "text": "SF YIMBY (Nov 2024): about 125,000 sq ft total, 105,500 sq ft residential, 8,580 sq ft parking; construction cost at least $76 million; site 1.11 acres.",
      "src": [
        "SRC-003016"
      ]
    },
    {
      "text": "City lot line adjustment AT23-001 combined two parcels on the 1.11-gross-acre site; the 2021 state application row lists APNs 467-14-054 and 467-14-076.",
      "src": [
        "SRC-001956",
        "SRC-001107"
      ]
    }
  ],
