  "construction_notes": [
    {
      "text": "Imported from the state Housing Element Annual Progress Report, which cities file themselves and which runs through 2025. Not yet checked against the city's own project list.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-23-517: Stevens Creek Promenade, located at 4300 Stevens Creek Boulevard in San Jose, requested and is being recommended for a reservation of $5,867,538 in annual federal tax credits and $19,600,000 in total state tax credits to finance the new construction of 171 units of housing serving families with rents affordable to households earning 30%-70% of area median income (AMI). Recorded as a note because this funding covers Stevens Creek Promenade (173 units), which may be one component of this record.",
      "src": [
        "SRC-001638"
      ]
    },
    {
      "text": "580 homes (407 market-rate, 173 affordable), 10,850 sq ft retail, 250 hotel rooms. Pacific West Builders is to develop the affordable housing portion following a $3.5 million sale.",
      "src": [
        "SRC-001783"
      ]
    }
  ],
