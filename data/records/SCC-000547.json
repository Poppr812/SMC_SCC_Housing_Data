  "construction_notes": [
    {
      "text": "City permit data for PLN-2026-20: nine new three-story townhomes with a Tentative Subdivision Map, easements and right-of-way dedication, under the Starter Home Revitalization Act. Status Decision Rendered, updated 2026-11-02. Case manager Stephen Rose. The city's Starter Home Projects page lists the zoning as Multi-Family.",
      "src": [
        "SRC-001549",
        "SRC-003790"
      ]
    },
    {
      "text": "Preliminary application PLN-2025-120 (Ohadi) described demolition of two existing warehouse buildings and a 9-unit townhome development of about 1,400 to 1,500 sq ft per unit with private garages. A 2022 zoning letter request (PLN-2022-144) described 120 and 132 Kennedy Ave as office and warehouse.",
      "src": [
        "SRC-001551"
      ]
    },
    {
      "text": "MLS ML81954871 (listed 2024-02-20, closed 2024-04-09): 120 Kennedy has a 1,344 sq ft building on 5,347 sq ft of land and 132 Kennedy a 2,640 sq ft building on a 5,938 sq ft lot; zoning described as PD Medium to High Density Residential.",
      "src": [
        "SRC-004103"
      ]
    }
