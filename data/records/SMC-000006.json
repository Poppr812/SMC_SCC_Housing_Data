          ]
        },
        {
          "value": "Presidio Bay Ventures proposal: 347 workforce units, 60% at 100% AMI and 40% at 80% AMI; funding gap about $45 million",
          "src": [
            "SRC-000118"
          ]
        },
        {
          "value": "Related California / Alta Housing proposal: 500 units, 346 affordable plus a 154-unit market-rate building; funding gap about $19 million",
          "src": [
            "SRC-000118"
          ]
        }
      ],
      "combine": true
    }
