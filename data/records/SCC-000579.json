  "construction_notes": [
    {
      "text": "CTCAC CA-22-589: View at Blossom Hill, located at 1007 Blossom Hill in San Jose, requested and is being recommended for a reservation of $7,211,099 in annual federal tax credits to finance the new construction of 267 units of housing serving tenants with rents affordable to households earning 30%-70% of area median income (AMI).",
      "src": [
        "SRC-001607"
      ]
    },
    {
      "text": "City of San Jose permit H21-020 (Site Development Permit/Amendment, folder year 2021), status Approved, issue date 2022-08-03: \"Site Development Permit to allow the demolition (approx. 11,275 square feet) of an existing commercial building (Fish Market) and the construction of a seven-story building, with five-stories of multi-family 100% affordable residential housing units (271\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "Council memo (2022-10-17): TEFRA approval for up to $95,000,000 of tax-exempt bonds issued by the California Municipal Finance Authority to View at Blossom Hill, LP (JEMCOR Development Partners, LLC or an affiliate as general partner) for a 271-unit project at 1007 Blossom Hill Road; 267 units at 30-70% AMI plus four unrestricted manager units; no City loan; CMFA recycled bonds as an additional construction source.",
      "src": [
        "SRC-002473"
      ]
    },
    {
      "text": "SF YIMBY (2021): Jemcor Development Partners LLC sponsor, Water Dragon 289 LLC property owner; 269 deed-restricted affordable units, seven stories, average unit 767 sq ft (586 to 1,200 sq ft) on a 1.9-acre parcel replacing an 11,900 sq ft restaurant; start mid-2022, completion anticipated 2024.",
      "src": [
        "SRC-002472",
        "SRC-002471"
      ]
    },
    {
      "text": "Listing (RentCafe): 1001 Blossom Hill Road, 271 units, seven stories, built 2026, managed by Avenue5 Residential, LLC; one-bedroom 600-659 sq ft, two-bedroom 715-844 sq ft, three-bedroom 1,078-1,089 sq ft. The CTCAC CA-22-589 staff report names FPI Management as property manager.",
      "src": [
        "SRC-002470"
      ]
    }
  ],
