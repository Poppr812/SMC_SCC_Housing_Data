  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001118",
        "SRC-001119"
      ]
    },
    {
      "text": "CTCAC CA-26-457: The project, 245 Weddell, located at 245-251 West Weddell Drive in Sunnyvale on a 1.72 acre site, requested $5,832,651 in annual federal tax credits but is being recommended for $5,736,199 in annual federal tax credits and $32,018,486 of tax-exempt bond cap to finance the new construction & acquisition & rehabilitation of 123 units of housing, consisting of 121 restricted rental units and 2 unrestricted manager's units.",
      "src": [
        "SRC-001677"
      ]
    },
    {
      "text": "Existing Orchard Gardens has 62 apartments. Two 16-unit buildings (19,990 sq ft, 32 units) are demolished and replaced by a new 6-story Type 3A/1A building of 114,800 sq ft with 93 units; 30 existing units are substantially rehabilitated. SF YIMBY (2021) gives the new building as 115,800 sq ft and the existing Park View building as 30,720 sq ft.",
      "src": [
        "SRC-002842",
        "SRC-002843",
        "SRC-001119"
      ]
    },
    {
      "text": "First Community Housing: 46 of the new units for income-qualifying current residents, 2 manager/maintenance units; all units affordable below 60% AMI; designed as LEED Platinum.",
      "src": [
        "SRC-002842"
      ]
    },
    {
      "text": "APR 2021 entitlement row: 87 very low, 34 low, 2 above moderate, 47 extremely low-income; 32 rental units demolished; deed restriction by local funding regulatory agreement; LIHTC and County Measure A planned.",
      "src": [
        "SRC-001119"
      ]
    },
    {
      "text": "Housing Trust Silicon Valley (June 2019) described the redevelopment as bringing the property to 86 affordable homes.",
      "src": [
        "SRC-002844"
      ]
    }
  ],
