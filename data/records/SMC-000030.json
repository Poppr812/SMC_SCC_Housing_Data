  "construction_notes": [
    {
      "text": "Eight stories, terraced, over a three-level subterranean garage; replaces the Bel Mateo Motel",
      "src": [
        "SRC-000611"
      ]
    },
    {
      "text": "CTCAC CA-23-488: Belmont Family Apartments, located at 800-803 Belmont Avenue in Belmont, requested and is being recommended for a reservation of $5,707,459 in annual federal tax credits and $32,921,993 in total state tax credits to finance the new construction of 124 units of housing serving families with rents affordable to households earning 30%-70% of area median income (AMI).",
      "src": [
        "SRC-001637"
      ]
    },
    {
      "text": "BKF Engineers provided civil engineering and land surveying for client ROEM Development Corporation. BKF describes 125 affordable units for low-income families and formerly homeless veterans, about 6,500 sq ft of outdoor recreation space including a children's playground, a club room and a computer room. The project received a 2022 PCBC Gold Nugget Award of Merit, Best On-the-Boards Affordable Housing Community.",
      "src": [
        "SRC-002837"
      ]
    },
    {
      "text": "City bulletin of Sept. 18, 2026: 125 units (52 one-bedroom, 40 two-bedroom, 33 three-bedroom) on a 1.5-acre site at Belmont Avenue and El Camino Real, formerly the Bel-Mateo Motel and vacant land.",
      "src": [
        "SRC-002838"
      ]
    },
    {
      "text": "The 2024 APR row lists APNs 044-172-190 and 044-172-200 and financial assistance LIHTC, PBS8, HOME, CDLAC and Other. The county active parcel layer returns only APN 044-172-230 (803 Belmont Ave, owner Belmont Family Apartments LP) with a legal start date of 2024-05-15.",
      "src": [
        "SRC-000643",
        "SRC-002839"
      ]
    }
  ],
