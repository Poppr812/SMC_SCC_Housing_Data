  "construction_notes": [
    {
      "text": "APN from the state notice for Surface Parking Lot T; county parcel data shows it as 424 Lytton Av.",
      "src": [
        "SRC-001270"
      ]
    },
    {
      "text": "Six stories: one-story Type I-A podium with five levels of Type III-A above; about 76,400 sq ft (city page) or 76,514 sq ft (applicant counsel letter). Replaces a 52-space city-owned surface lot at Lytton Avenue and Kipling Street; PF zoning.",
      "src": [
        "SRC-001269",
        "SRC-003256"
      ]
    },
    {
      "text": "City found the project exempt from CEQA under AB 130 (PRC 21080.66).",
      "src": [
        "SRC-001269"
      ]
    },
    {
      "text": "Downtown Vibrancy, a group of downtown property owners, sued the city claiming the assessment-funded parking lots cannot be converted; the city says construction would not start before 2028.",
      "src": [
        "SRC-003258",
        "SRC-003257"
      ]
    },
    {
      "text": "Oct. 2025: Alta reported a $2.27 million funding gap after the city contribution; options named included county funds and the Housing Accelerator Fund.",
      "src": [
        "SRC-003259"
      ]
    },
    {
      "text": "City had endorsed a five-story, 54-unit design in January 2025 before the 72-unit version.",
      "src": [
        "SRC-003257"
      ]
    }
  ],
