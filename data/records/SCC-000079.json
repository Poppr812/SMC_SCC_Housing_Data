  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001099",
        "SRC-001107"
      ]
    },
    {
      "text": "CTCAC CA-23-545: View at Julian, located at 950-970 West Julian Street in San Jose, requested and is being recommended for a reservation of $6,821,856 in annual federal tax credits to finance the new construction of 296 units of housing serving tenants with rents affordable to households earning 30%-70% of area median income (AMI).",
      "src": [
        "SRC-001640"
      ]
    },
    {
      "text": "City of San Jose permit H21-044 (Site Development Permit/Amendment, folder year 2021), status Approved, issue date 2022-08-17: \"Site Development Permit to allow the demolition of two existing commercial buildings totaling approximately 19,820 square feet for the construction of a 100% affordable, eight-story (Density Bonus), 300-unit multifamily building on an approximately 1.10-g\" (city text cut off at 255 characters)",
      "src": [
        "SRC-001956"
      ]
    },
    {
      "text": "County parcel data: 950 W Julian St is APN 261-02-065. APN 467-05-052 has situs 970 E Julian St.",
      "src": [
        "SRC-001098"
      ]
    },
    {
      "text": "City GIS: project files at 950 Julian St are recorded under APN 261-02-062, and an environmental file at 970 Julian St under APN 261-02-049. SB 330 preliminary application PRE21-141 described about 300 units, about 7,700 sq ft of leasing/amenity space, 85 vehicle spaces, 75 motorcycle spaces and 75 long-term bicycle spaces.",
      "src": [
        "SRC-001956"
      ]
    }
  ],
