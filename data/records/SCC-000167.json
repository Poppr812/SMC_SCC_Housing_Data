  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001126",
        "SRC-001127"
      ]
    },
    {
      "text": "CTCAC CA-25-595: El Camino Real Multifamily, located at 3001 El Camino Real in Palo Alto on a 1.14 acre site, requested and is being recommended for a reservation of $5,248,603 in annual federal tax credits and $26,000,000 in total state tax credits and $53,248,129 of tax-exempt bond cap to finance the new construction of 130 units of housing, consisting of 128 restricted rental units and 2 unrestricted manager's units.",
      "src": [
        "SRC-001664"
      ]
    },
    {
      "text": "ARB staff report: replaces two vacant retail buildings (formerly Mike's Bikes, 9,000 sq ft) and a surface lot; most of the building is 60 feet, stair features reach 66 feet 3 inches; concessions include FAR from 0.6:1 to 2.7:1 and lot coverage from 50% to 74%. ARB also reviewed the project on 2022-11-17 and 2023-03-02.",
      "src": [
        "SRC-002866"
      ]
    },
    {
      "text": "Patch, on the county approval: 32 rapid rehousing units, 30 units for households earning up to $54,390, 65 for households earning up to $90,650, and 2 managers' units.",
      "src": [
        "SRC-002871"
      ]
    },
    {
      "text": "Developer page: 130 units restricted to 30%-60% AMI; 25% reserved for rapid-rehousing households referred by the County Office of Supportive Housing.",
      "src": [
        "SRC-002867"
      ]
    },
    {
      "text": "CEQAnet lists APN 132-37-055 for the project; the current county parcel layer has situs 3001 El Camino Real on APN 132-37-074.",
      "src": [
        "SRC-002868"
      ]
    }
