  "construction_notes": [
    {
      "text": "From the state Housing Element Annual Progress Report, through 2025.",
      "src": [
        "SRC-001131",
        "SRC-001135"
      ]
    },
    {
      "text": "CTCAC CA-25-477: The Magnolias, located at 17965 Monterey Road in Morgan Hill on a 1.53 acre site, requested and is being recommended for a reservation of $3,124,138 in annual federal tax credits and $32,378,000 of tax-exempt bond cap to finance the new construction of 66 units of housing, consisting of 65 restricted rental units and 1 unrestricted manager's unit.",
      "src": [
        "SRC-001661"
      ]
    },
    {
      "text": "City page unit mix: 16 studios, 16 one-bedroom, 17 two-bedroom, 17 three-bedroom (one for on-site staff); CTCAC and Eden list 15, 16, 17 and 18. Building about 59 feet tall, reduced from 68 feet in the 2021 design; approval amended in 2024 for a cost-reduction redesign.",
      "src": [
        "SRC-001445",
        "SRC-001661"
      ]
    },
    {
      "text": "CTCAC staff report: deferred developer fee $3,100,000; developer fee $5,900,000; per-unit cost $991,640; Type I construction; one residential building.",
      "src": [
        "SRC-001661"
      ]
    },
    {
      "text": "Eden release lists funding partners: City of Morgan Hill, County of Santa Clara, Santa Clara County Housing Authority, CTCAC, CDLAC, California Municipal Finance Authority, Capital One, National Equity Fund, Citibank and Destination: HOME.",
      "src": [
        "SRC-003349"
      ]
    }
  ],
